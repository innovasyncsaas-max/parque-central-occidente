window.deleteResidente = async function(id) {
  await deleteDoc(doc(db, "residentes", id));
};

window.fetchResidentes = async function() {
  const snapshot = await getDocs(collection(db, "residentes"));
  const docs = [];
  snapshot.forEach(d => docs.push({ id: d.id, ...d.data() }));
  return docs.sort((a,b) => (b.fechaRegistro?.seconds||0) - (a.fechaRegistro?.seconds||0));
};

