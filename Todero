<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PCO3 · Todero</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --primary:#1e3a5f;--primary-light:#2d5a8e;--primary-dark:#152d4a;
  --success:#10b981;--warning:#f59e0b;--danger:#ef4444;--purple:#7c3aed;
  --bg:#f0f4f8;--card:#fff;--text:#1a202c;--muted:#64748b;
  --border:#e2e8f0;--radius:12px;--nav-w:220px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
header{background:linear-gradient(135deg,var(--primary-dark),var(--primary));color:#fff;padding:14px 20px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.2)}
header .badge{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:20px;padding:3px 10px;font-size:11px;font-weight:600}
header h1{font-size:17px;font-weight:700}
header p{font-size:12px;opacity:.8}
.user-info{margin-left:auto;text-align:right;font-size:12px;opacity:.85}
.layout{display:flex;min-height:calc(100vh - 56px)}
main{flex:1;padding:16px;padding-bottom:90px;min-width:0}
nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--border);display:flex;z-index:100;box-shadow:0 -2px 8px rgba(0,0,0,.08)}
nav button{flex:1;padding:10px 4px 8px;border:none;background:none;color:var(--muted);font-family:'DM Sans',sans-serif;font-size:10px;font-weight:500;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;transition:.2s;position:relative}
nav button .icon{font-size:20px}
nav button.active{color:var(--primary);font-weight:700}
.nav-badge{position:absolute;top:4px;right:calc(50% - 18px);background:var(--danger);color:#fff;font-size:9px;font-weight:700;min-width:16px;height:16px;border-radius:8px;display:none;align-items:center;justify-content:center;padding:0 4px}
.nav-badge.show{display:flex}
@media(min-width:768px){
  main{padding:24px;padding-bottom:24px;margin-left:var(--nav-w)}
  nav{position:fixed;left:0;top:56px;bottom:0;right:auto;width:var(--nav-w);flex-direction:column;border-top:none;border-right:1px solid var(--border);background:#fff;padding:12px 0;box-shadow:2px 0 8px rgba(0,0,0,.04)}
  nav button{flex:none;flex-direction:row;padding:12px 20px;font-size:13px;gap:10px;border-radius:0;justify-content:flex-start}
  nav button.active{background:#eff6ff;color:var(--primary);border-right:3px solid var(--primary)}
  .nav-badge{position:static;margin-left:auto}
  .stat-grid{grid-template-columns:repeat(4,1fr)}
}
.section{display:none}.section.active{display:block}
.card{background:var(--card);border-radius:var(--radius);padding:16px;margin-bottom:12px;box-shadow:0 1px 4px rgba(0,0,0,.06);border:1px solid var(--border)}
.card-title{font-weight:700;font-size:14px;color:var(--primary);margin-bottom:12px;display:flex;align-items:center;gap:8px}
.section-header{display:flex;align-items:center;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.section-header h2{font-size:18px;font-weight:700;color:var(--primary)}
.stat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:16px}
.stat-box{background:var(--card);border-radius:var(--radius);padding:14px 10px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,.06);border:1px solid var(--border)}
.stat-box .num{font-size:28px;font-weight:700;color:var(--primary)}
.stat-box .lbl{font-size:11px;color:var(--muted);margin-top:2px}
.stat-box.alerta .num{color:var(--danger)}
.stat-box.ok .num{color:var(--success)}
.stat-box.warn .num{color:var(--warning)}
.btn{width:100%;padding:12px;border:none;border-radius:10px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:.2s}
.btn-primary{background:var(--primary);color:#fff}
.btn-success{background:var(--success);color:#fff}
.btn-warning{background:var(--warning);color:#fff}
.btn-danger{background:var(--danger);color:#fff}
.btn-sm{padding:7px 14px;font-size:12px;border-radius:8px;font-weight:600;border:none;cursor:pointer;font-family:'DM Sans',sans-serif;transition:.2s;display:inline-block}
.btn-secondary{background:var(--border);color:var(--text)}
.input{width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:10px;font-family:'DM Sans',sans-serif;font-size:14px;color:var(--text);background:#fff;transition:.2s}
.input:focus{outline:none;border-color:var(--primary)}
.label{font-size:12px;font-weight:600;color:var(--muted);margin-bottom:4px;display:block}
.form-group{margin-bottom:14px}
.select{width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:10px;font-family:'DM Sans',sans-serif;font-size:14px;background:#fff;color:var(--text)}
.filter-bar{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:12px}
.filter-bar::-webkit-scrollbar{display:none}
.chip{flex-shrink:0;padding:5px 14px;border-radius:20px;font-size:12px;font-weight:600;border:1.5px solid var(--border);background:var(--card);color:var(--muted);cursor:pointer;transition:.2s}
.chip.active{background:var(--primary);color:#fff;border-color:var(--primary)}
.list-item{padding:14px;border:1px solid var(--border);border-radius:var(--radius);margin-bottom:10px;background:var(--card);box-shadow:0 1px 3px rgba(0,0,0,.04)}
.list-item.alta{border-left:4px solid var(--danger)}
.list-item.media{border-left:4px solid var(--warning)}
.list-item.baja{border-left:4px solid var(--success)}
.list-item-title{font-weight:700;font-size:14px;margin-bottom:3px}
.list-item-sub{font-size:12px;color:var(--muted);margin-top:2px}
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:200;align-items:center;justify-content:center;padding:16px}
.modal-overlay.open{display:flex}
.modal{background:#fff;border-radius:16px;width:100%;max-width:460px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.3);max-height:92vh;display:flex;flex-direction:column}
.modal-header{padding:16px;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.modal-header.success{background:var(--success)}
.modal-header.warning{background:var(--warning)}
.modal-header h3{font-size:15px;font-weight:700}
.modal-close{background:none;border:none;color:#fff;font-size:22px;cursor:pointer;line-height:1}
.modal-body{padding:16px;overflow-y:auto}
.modal-footer{padding:12px 16px;border-top:1px solid var(--border);display:flex;gap:8px;flex-shrink:0}
.badge-estado{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:600}
.badge-pendiente{background:#f1f5f9;color:#475569}
.badge-en-proceso{background:#fef3c7;color:#b45309}
.badge-completada{background:#e9d5ff;color:#6b21a8}
.badge-aprobada{background:#d1fae5;color:#065f46}
.badge-rechazada{background:#fee2e2;color:#b91c1c}
.empty{text-align:center;padding:30px 16px;color:var(--muted)}
.empty .icon{font-size:36px;margin-bottom:8px}
.empty p{font-size:13px}
.toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:var(--primary);color:#fff;padding:10px 20px;border-radius:10px;font-size:13px;font-weight:600;z-index:999;opacity:0;transition:.3s;pointer-events:none;white-space:nowrap;max-width:90vw}
.toast.show{opacity:1}
.toast.error{background:var(--danger)}
.urgente-banner{background:#fef2f2;border:2px solid var(--danger);border-radius:12px;padding:14px;margin-bottom:14px}
.urgente-title{font-weight:700;font-size:14px;color:var(--danger);margin-bottom:4px}
.devuelta-banner{background:#fef3c7;border:2px solid var(--warning);border-radius:12px;padding:14px;margin-bottom:14px}
.devuelta-title{font-weight:700;font-size:14px;color:var(--warning);margin-bottom:4px}
.foto-preview{width:100%;border-radius:10px;max-height:200px;object-fit:cover;margin-top:8px;display:none;cursor:pointer}
.foto-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:12px;border:2px dashed var(--border);border-radius:10px;background:var(--bg);font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;color:var(--muted);cursor:pointer;transition:.2s}
.foto-btn:hover{border-color:var(--primary);color:var(--primary)}
.foto-btn.tiene-foto{border-color:var(--success);color:var(--success);background:#f0fdf4}
.prioridad-tag{display:inline-block;padding:2px 9px;border-radius:6px;font-size:11px;font-weight:700;text-transform:uppercase}
.prioridad-alta{background:#fee2e2;color:#b91c1c}
.prioridad-media{background:#fef3c7;color:#b45309}
.prioridad-baja{background:#d1fae5;color:#065f46}
</style>
</head>
<body>

<header>
  <div>
    <div class="badge">🔧 TODERO</div>
    <h1>PCO3 Ciudadela</h1>
    <p id="headerFecha">—</p>
  </div>
  <div class="user-info">
    <div id="headerNombre">Todero</div>
    <div>Mantenimiento</div>
  </div>
</header>

<div class="layout">
<main>

<!-- INICIO -->
<div id="sec-inicio" class="section active">
  <div class="section-header"><h2>Mi Día</h2></div>

  <div class="stat-grid">
    <div class="stat-box" id="box-pendientes">
      <div class="num" id="stat-pendientes">0</div>
      <div class="lbl">Pendientes</div>
    </div>
    <div class="stat-box" id="box-proceso">
      <div class="num" id="stat-proceso">0</div>
      <div class="lbl">En proceso</div>
    </div>
    <div class="stat-box" id="box-completadas">
      <div class="num" id="stat-completadas">0</div>
      <div class="lbl">Para revisar</div>
    </div>
    <div class="stat-box" id="box-rechazadas">
      <div class="num" id="stat-rechazadas">0</div>
      <div class="lbl">Devueltas</div>
    </div>
  </div>

  <div id="urgentes-cont"></div>
  <div id="devueltas-cont"></div>

  <div class="card">
    <div class="card-title">📋 Próximas tareas</div>
    <div id="proximas-lista">
      <div class="empty"><div class="icon">🔧</div><p>Sin tareas asignadas hoy</p></div>
    </div>
  </div>
</div>

<!-- MIS TAREAS -->
<div id="sec-tareas" class="section">
  <div class="section-header"><h2>Mis Tareas</h2></div>

  <div class="filter-bar" id="filtro-tareas-chips">
    <div class="chip active" data-val="activas" onclick="setFiltroTareas(this)">Activas</div>
    <div class="chip" data-val="pendiente" onclick="setFiltroTareas(this)">Pendientes</div>
    <div class="chip" data-val="en_proceso" onclick="setFiltroTareas(this)">En proceso</div>
    <div class="chip" data-val="completada_pendiente_revision" onclick="setFiltroTareas(this)">Enviadas</div>
    <div class="chip" data-val="rechazada" onclick="setFiltroTareas(this)">Devueltas</div>
    <div class="chip" data-val="aprobada" onclick="setFiltroTareas(this)">Aprobadas</div>
  </div>

  <div id="lista-tareas-todero">
    <div class="empty"><div class="icon">🔄</div><p>Cargando tareas...</p></div>
  </div>
</div>

<!-- REPORTAR NOVEDAD -->
<div id="sec-novedad" class="section">
  <div class="section-header"><h2>Reportar Novedad</h2></div>

  <div class="card">
    <div class="card-title">⚠️ Nueva novedad de mantenimiento</div>

    <div class="form-group">
      <label class="label">Tipo de novedad *</label>
      <select class="select" id="nov-tipo">
        <option value="Avería eléctrica">⚡ Avería eléctrica</option>
        <option value="Avería hidráulica">💧 Avería hidráulica</option>
        <option value="Daño estructural">🏗️ Daño estructural</option>
        <option value="Daño en fachada">🧱 Daño en fachada</option>
        <option value="Equipo dañado">⚙️ Equipo dañado</option>
        <option value="Riesgo de seguridad">🔒 Riesgo de seguridad</option>
        <option value="Fuga de agua">🌊 Fuga de agua</option>
        <option value="Iluminación">💡 Iluminación</option>
        <option value="Otro">📋 Otro</option>
      </select>
    </div>

    <div class="form-group">
      <label class="label">Área / Ubicación *</label>
      <select class="select" id="nov-area">
        <option value="Piscina">Piscina</option>
        <option value="Gimnasio">Gimnasio</option>
        <option value="Zona BBQ">Zona BBQ</option>
        <option value="Salón Social">Salón Social</option>
        <option value="Parqueaderos">Parqueaderos</option>
        <option value="Acceso principal">Acceso principal</option>
        <option value="Corredores">Corredores</option>
        <option value="Cuarto de bombas">Cuarto de bombas</option>
        <option value="Red eléctrica">Red eléctrica</option>
        <option value="Torres - pisos">Torres / Pisos</option>
        <option value="Ascensores">Ascensores</option>
        <option value="Áreas verdes">Áreas verdes</option>
        <option value="Otro">Otro</option>
      </select>
    </div>

    <div class="form-group">
      <label class="label">Descripción detallada *</label>
      <textarea class="input" id="nov-descripcion" rows="4" placeholder="Describe la novedad con el mayor detalle posible..."></textarea>
    </div>

    <div class="form-group">
      <label class="label">Nivel de urgencia *</label>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
        <label style="display:flex;align-items:center;gap:6px;padding:10px;border:2px solid var(--border);border-radius:10px;cursor:pointer" id="nivel-baja-label">
          <input type="radio" name="nov-nivel" value="baja" onchange="actualizarNivel()">
          <span style="font-weight:600;font-size:12px">🟢 BAJA</span>
        </label>
        <label style="display:flex;align-items:center;gap:6px;padding:10px;border:2px solid var(--border);border-radius:10px;cursor:pointer" id="nivel-media-label">
          <input type="radio" name="nov-nivel" value="media" checked onchange="actualizarNivel()">
          <span style="font-weight:600;font-size:12px">🟡 MEDIA</span>
        </label>
        <label style="display:flex;align-items:center;gap:6px;padding:10px;border:2px solid var(--border);border-radius:10px;cursor:pointer" id="nivel-critica-label">
          <input type="radio" name="nov-nivel" value="critica" onchange="actualizarNivel()">
          <span style="font-weight:600;font-size:12px">🔴 CRÍTICA</span>
        </label>
      </div>
    </div>

    <div class="form-group">
      <label class="label">Foto de evidencia *</label>
      <input type="file" accept="image/*" capture="environment" id="nov-foto-input" style="display:none" onchange="procesarFotoNov(this)">
      <div class="foto-btn" id="nov-foto-btn" onclick="document.getElementById('nov-foto-input').click()">
        📷 Tomar foto de la novedad
      </div>
      <img id="nov-foto-preview" class="foto-preview">
    </div>

    <button class="btn btn-danger" onclick="enviarNovedad()">🚨 Enviar Novedad</button>
  </div>
</div>

<!-- HISTORIAL -->
<div id="sec-historial" class="section">
  <div class="section-header"><h2>Historial (7 días)</h2></div>
  <div id="lista-historial">
    <div class="empty"><div class="icon">🔄</div><p>Cargando historial...</p></div>
  </div>
</div>

</main>
</div>

<nav>
  <button class="active" onclick="navTo('inicio',this)"><span class="icon">🏠</span>Inicio</button>
  <button onclick="navTo('tareas',this)" id="nav-tareas-btn"><span class="icon">📋</span>Mis Tareas<div class="nav-badge" id="badge-tareas">0</div></button>
  <button onclick="navTo('novedad',this)"><span class="icon">⚠️</span>Reportar</button>
  <button onclick="navTo('historial',this)"><span class="icon">📂</span>Historial</button>
</nav>

<!-- MODAL COMPLETAR TAREA -->
<div class="modal-overlay" id="modal-completar">
  <div class="modal">
    <div class="modal-header success"><h3>Completar Tarea</h3><button class="modal-close" onclick="cerrarModal('modal-completar')">✕</button></div>
    <div class="modal-body">
      <div class="form-group">
        <label class="label">Tarea</label>
        <div id="completar-titulo" style="font-weight:700;padding:10px;background:var(--bg);border-radius:8px;font-size:13px"></div>
      </div>
      <div class="form-group">
        <label class="label">Notas de trabajo realizado *</label>
        <textarea class="input" id="completar-notas" rows="4" placeholder="Describe qué se hizo, materiales usados, tiempo, observaciones..."></textarea>
      </div>
      <div class="form-group">
        <label class="label">Foto de evidencia (antes/después) *</label>
        <input type="file" accept="image/*" capture="environment" id="completar-foto-input" style="display:none" onchange="procesarFotoCompletar(this)">
        <div class="foto-btn" id="completar-foto-btn" onclick="document.getElementById('completar-foto-input').click()">
          📷 Tomar foto de evidencia
        </div>
        <img id="completar-foto-preview" class="foto-preview">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary btn-sm" style="flex:1" onclick="cerrarModal('modal-completar')">Cancelar</button>
      <button class="btn btn-success btn-sm" style="flex:1" id="btn-confirmar-completar" onclick="confirmarCompletar()">Enviar para revisión</button>
    </div>
  </div>
</div>

<!-- MODAL DETALLE TAREA -->
<div class="modal-overlay" id="modal-detalle">
  <div class="modal">
    <div class="modal-header"><h3>Detalle de Tarea</h3><button class="modal-close" onclick="cerrarModal('modal-detalle')">✕</button></div>
    <div class="modal-body" id="modal-detalle-body"></div>
    <div class="modal-footer" id="modal-detalle-footer"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script type="module">
import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js';
import { getFirestore, collection, query, where, orderBy, onSnapshot, doc, addDoc, updateDoc, serverTimestamp } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js';
const firebaseConfig = {
  apiKey: "AIzaSyD3fprcNthKNU8fguyxdHC60pQ2T0PH5Ek",
  authDomain: "registro-residentes.firebaseapp.com",
  projectId: "registro-residentes",
  storageBucket: "registro-residentes.firebasestorage.app",
  messagingSenderId: "646123326163",
  appId: "1:646123326163:web:8b35b955e7b3692536a226"
};
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

// ─── STATE ────────────────────────────────────────────────
const S = {
  uid:'', nombre:'Todero',
  tareas:[], historial:[],
  filtroTareas:'activas',
  tareaaSel:null,
  fotoNovBlob:null, fotoCompletarBlob:null,
  enviando:false
};

// ─── HELPERS ──────────────────────────────────────────────
// FIX: zona horaria - fecha local de Bogotá
function fechaHoy() {
  const d = new Date();
  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
  return d.toISOString().split('T')[0];
}

function fechaHaceNDias(n) {
  const d = new Date();
  d.setDate(d.getDate() - n);
  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
  return d.toISOString().split('T')[0];
}

const ffd = ts => { if(!ts) return '--'; const d=ts.toDate?ts.toDate():new Date(ts); return d.toLocaleDateString('es-CO',{day:'2-digit',month:'2-digit',year:'2-digit'})+' '+d.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'}); };
const toast = (msg, tipo) => { const t=document.getElementById('toast'); t.textContent=msg; t.className='toast show'+(tipo==='error'?' error':''); setTimeout(()=>t.classList.remove('show'),3000); };
const cerrarModal = id => document.getElementById(id).classList.remove('open');
window.cerrarModal = cerrarModal;

// FIX: wrapper para listeners con manejo de errores explícito.
// Sin esto, las queries que requieren índice fallan en silencio.
function escuchar(q, onData, etiqueta) {
  return onSnapshot(q, onData, error => {
    console.error(`❌ Error en listener "${etiqueta}":`, error.code, error.message);
    if (error.code === 'failed-precondition') {
      console.error(`🔧 FALTA ÍNDICE COMPUESTO para "${etiqueta}". Busca arriba el URL que dice "create_composite=..." y créalo en Firebase Console. Espera 2-3 minutos a que termine de habilitarse.`);
      toast(`Falta índice: ${etiqueta} (ver consola F12)`, 'error');
    } else if (error.code === 'permission-denied') {
      console.error(`🔒 Permiso denegado para "${etiqueta}". Revisa firestore.rules.`);
    }
  });
}

// ─── SESSION ──────────────────────────────────────────────
(()=>{
  const p = new URLSearchParams(window.location.search);
  S.uid = p.get('uid')||localStorage.getItem('pco3_uid')||'todero_demo';
  S.nombre = p.get('nombre')||localStorage.getItem('pco3_nombre')||'Todero';
  if(p.get('uid')) localStorage.setItem('pco3_uid',S.uid);
  if(p.get('nombre')) localStorage.setItem('pco3_nombre',S.nombre);
  document.getElementById('headerNombre').textContent = S.nombre;
  const hoy = new Date();
  document.getElementById('headerFecha').textContent = hoy.toLocaleDateString('es-CO',{weekday:'long',day:'numeric',month:'long'});
})();

// ─── FOTO CON SELLO ───────────────────────────────────────
function aplicarSello(file, modulo, callback) {
  const img = new Image();
  const objUrl = URL.createObjectURL(file);
  img.onload = () => {
    const MAX = 400;
    let w = img.width, h = img.height;
    if (w > MAX) { h = Math.round(h * MAX / w); w = MAX; }
    const canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, w, h);
    const ahora = new Date();
    const sello = `PCO3 Ciudadela · ${modulo} · ${ahora.toLocaleDateString('es-CO')} ${ahora.toLocaleTimeString('es-CO')}`;
    const fh = Math.max(10, Math.round(h * 0.06));
    ctx.font = `bold ${fh}px Arial, sans-serif`;
    const tw = ctx.measureText(sello).width;
    const px = 6, py = 4;
    ctx.fillStyle = 'rgba(30,58,95,.78)';
    ctx.fillRect(0, h - fh - py * 2, tw + px * 2, fh + py * 2);
    ctx.fillStyle = '#fff';
    ctx.fillText(sello, px, h - py - 2);
    URL.revokeObjectURL(objUrl);
    callback(canvas.toDataURL('image/jpeg', 0.6));
  };
  img.onerror = () => { URL.revokeObjectURL(objUrl); callback(null); };
  img.src = objUrl;
}

