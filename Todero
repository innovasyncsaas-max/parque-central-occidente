// ─── LISTENERS ────────────────────────────────────────────
function iniciarListeners() {
  const hoy = fechaHoy();

  // Tareas del día asignadas a todero
  escuchar(
    query(collection(db,'tareas_mantenimiento'), where('fecha','==',hoy), where('asignado_a','==','todero'), orderBy('creado_en','desc')),
    snap => {
      S.tareas = snap.docs.map(d=>({id:d.id,...d.data()}));
      actualizarStats();
      renderTareas();
      renderProximas();
      renderUrgentes();
      renderDevueltas();
    },
    'tareas del día'
  );

  // Historial 7 días
  const fechaCorte = fechaHaceNDias(7);
  escuchar(
    query(collection(db,'tareas_mantenimiento'), where('asignado_a','==','todero'), where('fecha','>=',fechaCorte), orderBy('fecha','desc'), orderBy('creado_en','desc')),
    snap => {
      S.historial = snap.docs.map(d=>({id:d.id,...d.data()})).filter(t=>t.fecha!==hoy);
      renderHistorial();
    },
    'historial 7 días'
  );
}

// ─── STATS ────────────────────────────────────────────────
function actualizarStats() {
  const pend = S.tareas.filter(t=>t.estado==='pendiente').length;
  const proc = S.tareas.filter(t=>t.estado==='en_proceso').length;
  const comp = S.tareas.filter(t=>t.estado==='completada_pendiente_revision').length;
  const rech = S.tareas.filter(t=>t.estado==='rechazada').length;

  document.getElementById('stat-pendientes').textContent = pend;
  document.getElementById('stat-proceso').textContent = proc;
  document.getElementById('stat-completadas').textContent = comp;
  document.getElementById('stat-rechazadas').textContent = rech;

  document.getElementById('box-pendientes').className = 'stat-box'+(pend>0?' warn':'');
  document.getElementById('box-rechazadas').className = 'stat-box'+(rech>0?' alerta':'');
  document.getElementById('box-completadas').className = 'stat-box'+(comp>0?' ok':'');

  const totalActivo = pend + proc + rech;
  const badge = document.getElementById('badge-tareas');
  if (totalActivo > 0) { badge.textContent = totalActivo; badge.classList.add('show'); }
  else badge.classList.remove('show');
}

function renderUrgentes() {
  const urgentes = S.tareas.filter(t=>t.prioridad==='alta'&&t.estado==='pendiente');
  const cont = document.getElementById('urgentes-cont');
  if(!urgentes.length){ cont.innerHTML=''; return; }
  cont.innerHTML = urgentes.map(t=>`
    <div class="urgente-banner">
      <div class="urgente-title">🚨 Tarea urgente sin iniciar</div>
      <div style="font-weight:600;font-size:13px">${t.titulo}</div>
      <div style="font-size:12px;color:var(--muted);margin-top:2px">${t.area||'—'}</div>
      <button class="btn-sm btn-danger" style="margin-top:8px" onclick="iniciarTarea('${t.id}')">Iniciar ahora</button>
    </div>`).join('');
}

function renderDevueltas() {
  const devueltas = S.tareas.filter(t=>t.estado==='rechazada');
  const cont = document.getElementById('devueltas-cont');
  if(!devueltas.length){ cont.innerHTML=''; return; }
  cont.innerHTML = devueltas.map(t=>`
    <div class="devuelta-banner">
      <div class="devuelta-title">↩️ Tarea devuelta para corregir</div>
      <div style="font-weight:600;font-size:13px">${t.titulo}</div>
      <div style="font-size:12px;background:#fff;padding:8px;border-radius:6px;margin-top:6px;color:#92400e"><strong>Mensaje:</strong> ${t.rechazo_motivo||'Sin mensaje'}</div>
      <button class="btn-sm btn-warning" style="margin-top:8px" onclick="iniciarTarea('${t.id}')">Reanudar</button>
    </div>`).join('');
}

function renderProximas() {
  const activas = S.tareas.filter(t=>t.estado==='pendiente'||t.estado==='en_proceso').slice(0,5);
  const cont = document.getElementById('proximas-lista');
  if(!activas.length){ cont.innerHTML='<div class="empty"><div class="icon">✅</div><p>Sin tareas pendientes</p></div>'; return; }
  cont.innerHTML = activas.map(t=>`
    <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border)">
      <span style="font-size:22px">${t.estado==='en_proceso'?'🔄':'⏳'}</span>
      <div style="flex:1;min-width:0">
        <div style="font-weight:700;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${t.titulo}</div>
        <div style="font-size:11px;color:var(--muted)">${t.area||'—'} · <span class="prioridad-tag prioridad-${t.prioridad}">${t.prioridad}</span></div>
      </div>
      ${t.estado==='pendiente'
        ?`<button class="btn-sm btn-warning" onclick="iniciarTarea('${t.id}')">Iniciar</button>`
        :`<button class="btn-sm btn-success" onclick="abrirCompletar('${t.id}')">Completar</button>`}
    </div>`).join('');
}

window.setFiltroTareas = function(el) {
  S.filtroTareas = el.dataset.val;
  document.querySelectorAll('#filtro-tareas-chips .chip').forEach(c=>c.classList.remove('active')); el.classList.add('active');
  renderTareas();
};

function renderTareas() {
  let lista = [...S.tareas];
  const f = S.filtroTareas;
  if(f==='activas') lista = lista.filter(t=>t.estado==='pendiente'||t.estado==='en_proceso'||t.estado==='rechazada');
  else lista = lista.filter(t=>t.estado===f);

  const cont = document.getElementById('lista-tareas-todero');
  if(!lista.length){ cont.innerHTML='<div class="empty"><div class="icon">✅</div><p>Sin tareas en esta categoría</p></div>'; return; }

  cont.innerHTML = lista.map(t=>{
    const estadoInfo = {
      pendiente:{badge:'badge-pendiente',label:'Pendiente',icon:'⏳'},
      en_proceso:{badge:'badge-en-proceso',label:'En proceso',icon:'🔄'},
      completada_pendiente_revision:{badge:'badge-completada',label:'En revisión',icon:'🔍'},
      aprobada:{badge:'badge-aprobada',label:'Aprobada',icon:'✅'},
      rechazada:{badge:'badge-rechazada',label:'Devuelta',icon:'↩️'}
    };
    const ei = estadoInfo[t.estado]||{badge:'badge-pendiente',label:t.estado,icon:'📋'};
    return `
    <div class="list-item ${t.prioridad}">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:6px">
        <div style="flex:1">
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px">
            <span class="prioridad-tag prioridad-${t.prioridad}">${t.prioridad}</span>
            <span class="badge-estado ${ei.badge}">${ei.icon} ${ei.label}</span>
          </div>
          <div class="list-item-title">${t.titulo}</div>
          <div class="list-item-sub">${t.area||'—'} ${t.descripcion?'· '+t.descripcion.substring(0,50):''}</div>
          ${t.fecha_limite?`<div class="list-item-sub" style="margin-top:2px">⏰ Límite: ${t.fecha_limite}</div>`:''}
        </div>
      </div>
      ${t.rechazo_motivo?`<div style="background:#fef2f2;border:1px solid #fca5a5;border-radius:8px;padding:8px;font-size:12px;margin-bottom:8px;color:#b91c1c"><strong>Motivo devolución:</strong> ${t.rechazo_motivo}</div>`:''}
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <button class="btn-sm btn-secondary" onclick="verDetalle('${t.id}')">Ver detalle</button>
        ${t.estado==='pendiente'?`<button class="btn-sm btn-warning" onclick="iniciarTarea('${t.id}')">▶ Iniciar</button>`:''}
        ${t.estado==='en_proceso'?`<button class="btn-sm btn-success" onclick="abrirCompletar('${t.id}')">✅ Completar</button>`:''}
        ${t.estado==='rechazada'?`<button class="btn-sm btn-warning" onclick="iniciarTarea('${t.id}')">↩️ Reanudar</button>`:''}
      </div>
    </div>`;
  }).join('');
}

window.iniciarTarea = async function(id) {
  try {
    await updateDoc(doc(db,'tareas_mantenimiento',id),{
      estado:'en_proceso',
      iniciado_en:serverTimestamp(),
      iniciado_por:S.uid
    });
    toast('Tarea iniciada');
  } catch(e){ console.error(e); toast('Error al iniciar', 'error'); }
};

window.abrirCompletar = function(id) {
  const t = S.tareas.find(x=>x.id===id); if(!t) return;
  S.tareaaSel = t;
  S.fotoCompletarBlob = null;
  document.getElementById('completar-titulo').textContent = t.titulo;
  document.getElementById('completar-notas').value = '';
  document.getElementById('completar-foto-preview').style.display = 'none';
  document.getElementById('completar-foto-btn').className = 'foto-btn';
  document.getElementById('completar-foto-btn').textContent = '📷 Tomar foto de evidencia';
  document.getElementById('modal-completar').classList.add('open');
};

window.confirmarCompletar = async function() {
  const notas = document.getElementById('completar-notas').value.trim();
  if(!notas){ toast('Describe el trabajo realizado', 'error'); return; }
  if(!S.fotoCompletarBlob){ toast('La foto de evidencia es obligatoria', 'error'); return; }
  if(S.enviando) return;
  S.enviando = true;
  const btn = document.getElementById('btn-confirmar-completar');
  btn.textContent = 'Subiendo...'; btn.disabled = true;
  try {
    const fotoUrl = await subirFoto(S.fotoCompletarBlob);
    await updateDoc(doc(db,'tareas_mantenimiento',S.tareaaSel.id),{
      estado:'completada_pendiente_revision',
      completado_notas:notas,
      foto_evidencia:fotoUrl,
      completado_por:S.uid,
      completado_por_nombre:S.nombre,
      completado_en:serverTimestamp()
    });
    cerrarModal('modal-completar');
    toast('✅ Tarea enviada para revisión');
  } catch(e){ console.error(e); toast('Error al enviar', 'error'); }
  finally { S.enviando=false; btn.textContent='Enviar para revisión'; btn.disabled=false; }
};

window.verDetalle = function(id) {
  const t = S.tareas.find(x=>x.id===id)||S.historial.find(x=>x.id===id); if(!t) return;
  const estadoInfo = {
    pendiente:{badge:'badge-pendiente',label:'Pendiente'},
    en_proceso:{badge:'badge-en-proceso',label:'En proceso'},
    completada_pendiente_revision:{badge:'badge-completada',label:'En revisión'},
    aprobada:{badge:'badge-aprobada',label:'Aprobada'},
    rechazada:{badge:'badge-rechazada',label:'Devuelta'}
  };
  const ei = estadoInfo[t.estado]||{badge:'badge-pendiente',label:t.estado};
  document.getElementById('modal-detalle-body').innerHTML = `
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">
      <span class="prioridad-tag prioridad-${t.prioridad}">${t.prioridad}</span>
      <span class="badge-estado ${ei.badge}">${ei.label}</span>
    </div>
    <div class="form-group"><span class="label">Tarea</span><div style="font-weight:700;font-size:14px">${t.titulo}</div></div>
    <div class="form-group"><span class="label">Área</span><div>${t.area||'—'}</div></div>
    ${t.descripcion?`<div class="form-group"><span class="label">Descripción</span><div style="font-size:13px">${t.descripcion}</div></div>`:''}
    ${t.fecha_limite?`<div class="form-group"><span class="label">Fecha límite</span><div>${t.fecha_limite}</div></div>`:''}
    ${t.creado_por_nombre?`<div class="form-group"><span class="label">Asignada por</span><div style="font-size:13px">${t.creado_por_nombre}</div></div>`:''}
    ${t.completado_notas?`<div class="form-group"><span class="label">Trabajo realizado</span><div style="font-size:13px">${t.completado_notas}</div></div>`:''}
    ${t.foto_evidencia?`<div class="form-group"><span class="label">Foto evidencia</span><img src="${t.foto_evidencia}" style="width:100%;border-radius:8px;max-height:200px;object-fit:cover;cursor:pointer" onclick="window.open('${t.foto_evidencia}','_blank')"></div>`:''}
    ${t.rechazo_motivo?`<div style="background:#fef2f2;border:1px solid #fca5a5;border-radius:8px;padding:10px;font-size:13px;color:#b91c1c"><strong>↩️ Devuelta:</strong> ${t.rechazo_motivo}</div>`:''}`;
  document.getElementById('modal-detalle-footer').innerHTML =
    `<button class="btn btn-secondary btn-sm" style="flex:1" onclick="cerrarModal('modal-detalle')">Cerrar</button>
    ${t.estado==='en_proceso'?`<button class="btn btn-success btn-sm" style="flex:1" onclick="cerrarModal('modal-detalle');abrirCompletar('${t.id}')">Completar</button>`:''}
    ${t.estado==='pendiente'?`<button class="btn btn-warning btn-sm" style="flex:1" onclick="cerrarModal('modal-detalle');iniciarTarea('${t.id}')">Iniciar</button>`:''}
    ${t.estado==='rechazada'?`<button class="btn btn-warning btn-sm" style="flex:1" onclick="cerrarModal('modal-detalle');iniciarTarea('${t.id}')">Reanudar</button>`:''}`;
  document.getElementById('modal-detalle').classList.add('open');
};

window.enviarNovedad = async function() {
  const desc = document.getElementById('nov-descripcion').value.trim();
  if(!desc){ toast('Escribe la descripción', 'error'); return; }
  if(!S.fotoNovBlob){ toast('La foto de evidencia es obligatoria', 'error'); return; }
  if(S.enviando) return;
  S.enviando = true;
  const btn = document.querySelector('#sec-novedad .btn-danger');
  btn.textContent = 'Enviando...'; btn.disabled = true;
  const nivel = document.querySelector('input[name="nov-nivel"]:checked').value;
  const tipo = document.getElementById('nov-tipo').value;
  const area = document.getElementById('nov-area').value;
  try {
    const fotoUrl = await subirFoto(S.fotoNovBlob);
    // FIX: escribe AMBOS campos (nivel/severidad y estado/status) para que coordinador y admin lo vean
    await addDoc(collection(db,'novedades_mantenimiento'),{
      tipo, area, descripcion:desc,
      nivel,
      severidad: nivel.toUpperCase()==='CRITICA'?'CRÍTICO':nivel.toUpperCase()==='MEDIA'?'MEDIO':'BAJO',
      foto_url:fotoUrl,
      estado:'abierta',
      status:'ABIERTO',
      fecha:fechaHoy(),
      reportado_por:S.uid,
      reportado_por_nombre:S.nombre,
      creado_por:S.nombre,
      rol:'todero',
      creado_en:serverTimestamp(),
      timestamp:serverTimestamp()
    });
    document.getElementById('nov-descripcion').value='';
    document.getElementById('nov-foto-preview').style.display='none';
    document.getElementById('nov-foto-btn').className='foto-btn';
    document.getElementById('nov-foto-btn').textContent='📷 Tomar foto de la novedad';
    document.querySelector('input[name="nov-nivel"][value="media"]').checked=true;
    actualizarNivel();
    S.fotoNovBlob=null;
    toast('✅ Novedad reportada correctamente');
  } catch(e){ console.error(e); toast('Error al enviar novedad', 'error'); }
  finally { S.enviando=false; btn.textContent='🚨 Enviar Novedad'; btn.disabled=false; }
};

function renderHistorial() {
  const cont = document.getElementById('lista-historial');
  if(!S.historial.length){ cont.innerHTML='<div class="empty"><div class="icon">📂</div><p>Sin registros en los últimos 7 días</p></div>'; return; }

  const porFecha = {};
  S.historial.forEach(t=>{ if(!porFecha[t.fecha]) porFecha[t.fecha]=[];  porFecha[t.fecha].push(t); });

  cont.innerHTML = Object.entries(porFecha).map(([fecha,tareas])=>`
    <div style="font-size:12px;font-weight:700;color:var(--muted);margin-bottom:6px;margin-top:8px;text-transform:uppercase">${fecha}</div>
    ${tareas.map(t=>{
      const estadoBadges = {aprobada:'badge-aprobada',rechazada:'badge-rechazada',completada_pendiente_revision:'badge-completada',en_proceso:'badge-en-proceso',pendiente:'badge-pendiente'};
      const estadoLabels = {aprobada:'✅ Aprobada',rechazada:'↩️ Devuelta',completada_pendiente_revision:'🔍 En revisión',en_proceso:'🔄 En proceso',pendiente:'⏳ Pendiente'};
      return `<div class="list-item ${t.prioridad}" style="margin-bottom:8px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
          <div style="flex:1;min-width:0">
            <div class="list-item-title">${t.titulo}</div>
            <div class="list-item-sub">${t.area||'—'}</div>
          </div>
          <span class="badge-estado ${estadoBadges[t.estado]||'badge-pendiente'}">${estadoLabels[t.estado]||t.estado}</span>
        </div>
        ${t.rechazo_motivo?`<div style="font-size:11px;color:var(--danger);margin-top:4px">Devuelta: ${t.rechazo_motivo}</div>`:''}
      </div>`;
    }).join('')}`).join('');
}

window.navTo = function(sec,btn) {
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));
  document.getElementById('sec-'+sec).classList.add('active');
  btn.classList.add('active');
};

