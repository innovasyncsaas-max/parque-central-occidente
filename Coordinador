<script type="module">
import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js';
import {
  getFirestore, collection, query, where, orderBy, onSnapshot,
  doc, addDoc, updateDoc, setDoc, serverTimestamp, getDocs
} from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js';

const firebaseConfig = {
  apiKey:"AIzaSyD3fprcNthKNU8fguyxdHC60pQ2T0PH5Ek", authDomain:"registro-residentes.firebaseapp.com", projectId:"registro-residentes",
  storageBucket:"registro-residentes.firebasestorage.app", messagingSenderId:"646123326163", appId:"1:646123326163:web:8b35b955e7b3692536a226"
};
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

// ─── HELPERS ──────────────────────────────────────────────
// FIX: zona horaria - usa fecha local de Bogotá, no UTC
function fechaHoy() {
  const d = new Date();
  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
  return d.toISOString().split('T')[0];
}

const fh = ts => { if(!ts) return '--'; const d = ts.toDate?ts.toDate():new Date(ts); return d.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'}); };
const ffd = ts => { if(!ts) return '--'; const d = ts.toDate?ts.toDate():new Date(ts); return d.toLocaleDateString('es-CO',{day:'2-digit',month:'2-digit',year:'2-digit'}) + ' ' + d.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'}); };
const toast = (msg, tipo) => { const t=document.getElementById('toast'); t.textContent=msg; t.className='toast show' + (tipo==='error'?' error':''); setTimeout(()=>t.classList.remove('show'),3000); };
const cerrarModal = id => document.getElementById(id).classList.remove('open');
window.cerrarModal = cerrarModal;

// FIX: wrapper con manejo de errores para todos los listeners.
// Sin esto, los errores de índice faltante o permisos fallan en silencio.
function escuchar(q, onData, etiqueta) {
  return onSnapshot(q, onData, error => {
    console.error(`❌ Error en listener "${etiqueta}":`, error.code, error.message);
    if (error.code === 'failed-precondition') {
      console.error(`🔧 Falta índice compuesto para "${etiqueta}". Revisa el URL en el mensaje de error de arriba y créalo en Firebase Console.`);
      toast(`Falta índice: ${etiqueta} (ver consola)`, 'error');
    } else if (error.code === 'permission-denied') {
      console.error(`🔒 Permiso denegado en "${etiqueta}". Revisa firestore.rules.`);
      toast(`Sin permiso: ${etiqueta}`, 'error');
    }
  });
}

// FIX: normalizador — los módulos viejos escriben con nombres distintos.
// Esta función unifica todo a un formato canónico para el coordinador.
function normalizarNovedad(d, modulo) {
  // estado: puede venir como `estado` ('abierta'/'cerrada'/'listo_cierre') o `status` ('ABIERTO'/'CERRADO')
  let estado = d.estado;
  if (!estado && d.status) {
    estado = d.status === 'ABIERTO' ? 'abierta' :
             d.status === 'CERRADO' ? 'cerrada' :
             d.status.toLowerCase();
  }
  estado = estado || 'abierta';

  // nivel: puede venir como `nivel` ('crítica'/'media'/'baja') o `severidad` ('CRÍTICO'/'MEDIO'/'BAJO')
  let nivel = d.nivel;
  if (!nivel && d.severidad) {
    nivel = d.severidad.toLowerCase().includes('crít') ? 'critica' :
            d.severidad.toLowerCase().includes('medi') ? 'media' : 'baja';
  }
  nivel = nivel || 'baja';

  // tipo / área
  const tipo = d.tipo || d.area_afectada || '—';
  const area = d.area || d.area_afectada || '';

  // creado_en
  const creado_en = d.creado_en || d.timestamp;

  return { ...d, estado, nivel, tipo, area, creado_en, _m: modulo };
}

const nivelClass = n => { const v=(n||'').toLowerCase(); return v.includes('crit')?'critico':v.includes('medi')?'medio':'bajo'; };
const nivelBadge = n => { const v=(n||'').toLowerCase(); return v.includes('crit')?'badge-critico':v.includes('medi')?'badge-medio':'badge-bajo'; };
const estadoBadge = e => ({abierta:'badge-abierta',en_atencion:'badge-medio',listo_cierre:'badge-listo',cerrada:'badge-cerrada'}[e]||'badge-cerrada');
const estadoLabel = e => ({abierta:'Abierta',en_atencion:'En atención',listo_cierre:'Listo cierre',cerrada:'Cerrada'}[e]||e);
const colNov = m => ({pool:'pool_novedades',gym:'gym_novedades',mtto:'novedades_mantenimiento'}[m]||'seg_novedades');
const modTag = m => ({seg:'<span class="module-tag module-seg">SEG</span>',pool:'<span class="module-tag module-pool">PISCINA</span>',gym:'<span class="module-tag module-gym">GIMNASIO</span>',mtto:'<span class="module-tag module-mtto">MTTO</span>'}[m]||'');

// ─── STATE ────────────────────────────────────────────────
const S = {
  uid:'', nombre:'Coordinador',
  novSeg:[], novPool:[], novGym:[], novMtto:[],
  tareas:[], pqrs:[],
  tabNov:'seg', filtroNov:'todas',
  filtroTarea:'todas', filtroPQRCoord:'todas',
  novSel:null, tareaSel:null, servicioSel:null, pqrCoordSel:null,
  poolEstado:{}, gymEstado:{},
  unsubs: []
};

// ─── SESSION ──────────────────────────────────────────────
(()=>{
  const p = new URLSearchParams(window.location.search);
  S.uid = p.get('uid')||localStorage.getItem('pco3_uid')||'coord_demo';
  S.nombre = p.get('nombre')||localStorage.getItem('pco3_nombre')||'Coordinador';
  if(p.get('uid')) localStorage.setItem('pco3_uid',S.uid);
  if(p.get('nombre')) localStorage.setItem('pco3_nombre',S.nombre);
  document.getElementById('headerNombre').textContent = S.nombre;
  const hoy = new Date();
  document.getElementById('headerFecha').textContent = hoy.toLocaleDateString('es-CO',{weekday:'long',day:'numeric',month:'long'});
})();

// ─── LISTENERS ────────────────────────────────────────────
function iniciarListeners(){
  const hoy = fechaHoy();

  S.unsubs.push(escuchar(
    query(collection(db,'seg_novedades'),where('fecha','==',hoy)),
    s=>{ S.novSeg=s.docs.map(d=>normalizarNovedad({id:d.id,...d.data()},'seg')); refrescarTodo(); },
    'seg_novedades'
  ));

  S.unsubs.push(escuchar(
    query(collection(db,'pool_novedades'),where('fecha','==',hoy)),
    s=>{ S.novPool=s.docs.map(d=>normalizarNovedad({id:d.id,...d.data()},'pool')); refrescarTodo(); },
    'pool_novedades'
  ));

  S.unsubs.push(escuchar(
    query(collection(db,'gym_novedades'),where('fecha','==',hoy)),
    s=>{ S.novGym=s.docs.map(d=>normalizarNovedad({id:d.id,...d.data()},'gym')); refrescarTodo(); },
    'gym_novedades'
  ));

  S.unsubs.push(escuchar(
    query(collection(db,'novedades_mantenimiento'),where('fecha','==',hoy)),
    s=>{ S.novMtto=s.docs.map(d=>normalizarNovedad({id:d.id,...d.data()},'mtto')); refrescarTodo(); },
    'novedades_mantenimiento'
  ));

  S.unsubs.push(escuchar(
    query(collection(db,'tareas_mantenimiento'),where('fecha','==',hoy),orderBy('creado_en','desc')),
    s=>{ S.tareas=s.docs.map(d=>({id:d.id,...d.data()})); refrescarTodo(); },
    'tareas_mantenimiento'
  ));

  S.unsubs.push(escuchar(
    query(collection(db,'pqr'), orderBy('creado_en','desc')),
    s=>{ S.pqrs=s.docs.map(d=>({id:d.id,...d.data()})); actualizarStats(); renderPQRCoord(); },
    'pqr'
  ));

  S.unsubs.push(escuchar(
    doc(db,'pool_estado',hoy),
    s=>{ S.poolEstado=s.data()||{}; refrescarServicios(); },
    'pool_estado'
  ));

  S.unsubs.push(escuchar(
    doc(db,'gym_estado',hoy),
    s=>{ S.gymEstado=s.data()||{}; refrescarServicios(); },
    'gym_estado'
  ));
}

function refrescarTodo() {
  actualizarStats();
  renderNovedades();
  renderAlertasCriticas();
  renderPendientesCierre();
  renderTareas();
  renderPQRCoord();
  refrescarServicios();
}

// ─── STATS ────────────────────────────────────────────────
function actualizarStats(){
  const todas = [...S.novSeg,...S.novPool,...S.novGym,...S.novMtto];
  const abiertas = todas.filter(n=>n.estado==='abierta'||n.estado==='en_atencion').length;
  const listo = todas.filter(n=>n.estado==='listo_cierre').length;
  const tareasPend = S.tareas.filter(t=>t.estado==='pendiente'||t.estado==='en_proceso').length;
  const verifPend = S.tareas.filter(t=>t.estado==='completada_pendiente_revision').length;

  document.getElementById('stat-nov-total').textContent = abiertas;
  document.getElementById('stat-listo-cierre').textContent = listo;
  document.getElementById('stat-tareas-pend').textContent = tareasPend;
  document.getElementById('stat-verificacion').textContent = verifPend;
  document.getElementById('box-nov').className = 'stat-box'+(abiertas>0?' alerta':'');

  // Badges en el nav
  const badgeNov = document.getElementById('badge-nov');
  if (listo > 0) { badgeNov.textContent = listo; badgeNov.classList.add('show'); }
  else badgeNov.classList.remove('show');

  const badgeTareas = document.getElementById('badge-tareas');
  if (verifPend > 0) { badgeTareas.textContent = verifPend; badgeTareas.classList.add('show'); }
  else badgeTareas.classList.remove('show');

  const pqrPend = S.pqrs.filter(p=>p.estado==='abierto'||p.estado==='en_gestion').length;
  const badgePQR = document.getElementById('badge-pqr');
  if (pqrPend > 0) { badgePQR.textContent = pqrPend; badgePQR.classList.add('show'); }
  else badgePQR.classList.remove('show');
}

function refrescarServicios() {
  // Estado piscina
  const ps = S.poolEstado.suspendida === true;
  const pa = S.poolEstado.abierta === true;
  document.getElementById('stat-piscina').textContent = ps?'🔴 Susp.':(pa?'🟢 Abierta':'⚫ Cerrada');
  document.getElementById('box-piscina').className = 'stat-box'+(ps?' alerta':pa?' ok':'');

  // Estado gym
  const gs = S.gymEstado.suspendida === true;
  const ga = S.gymEstado.abierta === true;
  document.getElementById('stat-gimnasio').textContent = gs?'🔴 Susp.':(ga?'🟢 Abierto':'⚫ Cerrado');
  document.getElementById('box-gimnasio').className = 'stat-box'+(gs?' alerta':ga?' ok':'');

  // Cards detalladas en sección Servicios
  renderServicioCard('piscina', ps, pa, S.poolEstado);
  renderServicioCard('gym', gs, ga, S.gymEstado);

  // Banners de suspensión en dashboard
  renderBannersSuspension();

  // Badge en nav servicios
  const totalSusp = (ps?1:0) + (gs?1:0);
  const badgeServ = document.getElementById('badge-serv');
  if (totalSusp > 0) { badgeServ.textContent = totalSusp; badgeServ.classList.add('show'); }
  else badgeServ.classList.remove('show');
}

function renderServicioCard(servicio, suspendida, abierta, estado) {
  const card = document.getElementById(`serv-${servicio}`);
  const icon = document.getElementById(`serv-${servicio}-icon`);
  const txtEstado = document.getElementById(`serv-${servicio}-estado`);
  const acciones = document.getElementById(`serv-${servicio}-acciones`);

  card.classList.toggle('suspendido', suspendida);

  if (suspendida) {
    icon.textContent = '🔴';
    txtEstado.innerHTML = `<strong style="color:var(--danger)">SUSPENDIDA</strong><br>` +
      `<span style="font-size:11px">Motivo: ${estado.motivo || 'No especificado'}</span><br>` +
      `<span style="font-size:11px">Por: ${estado.suspendida_por || '—'}</span>`;
    acciones.innerHTML = `<button class="btn-sm btn-success" onclick="abrirReactivar('${servicio}')">▶ Reactivar</button>`;
  } else if (abierta) {
    icon.textContent = '🟢';
    txtEstado.innerHTML = `<strong style="color:var(--success)">Activa</strong>` +
      (estado.hora_apertura ? `<br><span style="font-size:11px">Abierta a las ${estado.hora_apertura} por ${estado.abierta_por||'—'}</span>` : '');
    acciones.innerHTML = '';
  } else {
    icon.textContent = '⚫';
    txtEstado.innerHTML = `<span style="color:var(--muted)">Cerrada / sin operación hoy</span>`;
    acciones.innerHTML = '';
  }
}

function renderBannersSuspension() {
  const cont = document.getElementById('servicios-suspendidos-cont');
  const banners = [];
  if (S.poolEstado.suspendida === true) {
    banners.push(`<div class="alert-suspendido">
      <div style="font-size:24px">🔴</div>
      <div style="flex:1;min-width:200px">
        <div style="font-weight:700;color:var(--danger)">Piscina SUSPENDIDA</div>
        <div style="font-size:12px;color:var(--muted)">${S.poolEstado.motivo||'Sin motivo registrado'}</div>
      </div>
      <button class="btn-sm btn-success" onclick="abrirReactivar('piscina')">▶ Reactivar</button>
    </div>`);
  }
  if (S.gymEstado.suspendida === true) {
    banners.push(`<div class="alert-suspendido">
      <div style="font-size:24px">🔴</div>
      <div style="flex:1;min-width:200px">
        <div style="font-weight:700;color:var(--danger)">Gimnasio SUSPENDIDO</div>
        <div style="font-size:12px;color:var(--muted)">${S.gymEstado.motivo||'Sin motivo registrado'}</div>
      </div>
      <button class="btn-sm btn-success" onclick="abrirReactivar('gym')">▶ Reactivar</button>
    </div>`);
  }
  cont.innerHTML = banners.join('');
}

// ─── REACTIVACIÓN DE SERVICIOS ────────────────────────────
window.abrirReactivar = function(servicio) {
  S.servicioSel = servicio;
  const nombre = servicio === 'piscina' ? 'Piscina y Jacuzzi' : 'Gimnasio';
  document.getElementById('reactivar-msg').textContent =
    `Vas a reactivar el servicio de ${nombre}. La operación quedará disponible nuevamente.`;
  document.getElementById('reactivar-motivo').value = '';
  document.getElementById('modal-reactivar').classList.add('open');
};

window.confirmarReactivar = async function() {
  const motivo = document.getElementById('reactivar-motivo').value.trim();
  if (!motivo) { toast('Escribe el motivo', 'error'); return; }
  const col = S.servicioSel === 'piscina' ? 'pool_estado' : 'gym_estado';
  try {
    await setDoc(doc(db, col, fechaHoy()), {
      suspendida: false,
      reactivado_motivo: motivo,
      reactivado_por: S.nombre,
      reactivado_por_id: S.uid,
      reactivado_en: serverTimestamp()
    }, { merge: true });
    cerrarModal('modal-reactivar');
    toast('✅ Servicio reactivado');
  } catch (e) {
    console.error(e);
    toast('Error al reactivar', 'error');
  }
};

// ─── ALERTAS CRÍTICAS ─────────────────────────────────────
function renderAlertasCriticas(){
  const criticas = [...S.novSeg,...S.novPool,...S.novGym,...S.novMtto]
    .filter(n=>(n.nivel||'').toLowerCase().includes('crit') && (n.estado==='abierta'||n.estado==='en_atencion'));
  const cont = document.getElementById('alertas-criticas-cont');
  if(!criticas.length){ cont.innerHTML=''; return; }
  cont.innerHTML = criticas.map(n=>`
    <div class="alert-critical">
      <div class="alert-critical-title">🚨 CRÍTICO — ${n._m==='pool'?'Piscina':n._m==='gym'?'Gimnasio':n._m==='mtto'?'Mantenimiento':'Seguridad'}</div>
      <div style="font-size:13px;font-weight:600">${n.tipo} ${n.area?'· '+n.area:''}</div>
      <div style="font-size:12px;color:#b91c1c;margin-top:2px">${n.descripcion||''}</div>
      <div style="font-size:11px;color:var(--muted);margin-top:4px">${ffd(n.creado_en)}</div>
    </div>`).join('');
}

// ─── PENDIENTES CIERRE ────────────────────────────────────
function renderPendientesCierre(){
  const lista = [...S.novSeg,...S.novPool,...S.novGym,...S.novMtto].filter(n=>n.estado==='listo_cierre');
  const cont = document.getElementById('pendientes-cierre-lista');
  if(!lista.length){ cont.innerHTML='<div class="empty"><div class="icon">✅</div><p>Sin pendientes</p></div>'; return; }
  cont.innerHTML = lista.map(n=>`
    <div class="list-item" style="border-left:4px solid var(--purple)">
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px">
        ${modTag(n._m)}<span class="badge-estado ${nivelBadge(n.nivel)}">${n.nivel}</span>
        <span class="badge-estado badge-listo">Listo cierre</span>
      </div>
      <div class="list-item-title">${n.tipo} ${n.area?'· '+n.area:''}</div>
      <div class="list-item-sub">${n.descripcion||''}</div>
      <div style="margin-top:8px">
        <button class="btn-sm btn-success" onclick="abrirCierreNov('${n.id}','${n._m}')">Cerrar definitivamente</button>
      </div>
    </div>`).join('');
}

// ─── NOVEDADES ────────────────────────────────────────────
window.setTabNov = function(mod,el){
  S.tabNov=mod;
  document.querySelectorAll('#tabs-modulo-nov .tab').forEach(t=>t.classList.remove('active')); el.classList.add('active');
  renderNovedades();
};
window.setFiltroNov = function(el){
  S.filtroNov=el.dataset.val;
  document.querySelectorAll('#filtro-nov-chips .chip').forEach(c=>c.classList.remove('active')); el.classList.add('active');
  renderNovedades();
};

function renderNovedades(){
  let lista = S.tabNov==='pool'?S.novPool:S.tabNov==='gym'?S.novGym:S.tabNov==='mtto'?S.novMtto:S.novSeg;
  const f=S.filtroNov;
  if(f==='abiertas') lista=lista.filter(n=>n.estado==='abierta'||n.estado==='en_atencion');
  else if(f==='criticas') lista=lista.filter(n=>(n.nivel||'').toLowerCase().includes('crit'));
  else if(f==='listo') lista=lista.filter(n=>n.estado==='listo_cierre');
  else if(f==='cerradas') lista=lista.filter(n=>n.estado==='cerrada');

  const cont = document.getElementById('lista-novedades');
  if(!lista.length){ cont.innerHTML='<div class="empty"><div class="icon">✅</div><p>Sin novedades</p></div>'; return; }
  cont.innerHTML = lista.map(n=>{
    const esActiva = n.estado==='abierta'||n.estado==='en_atencion';
    const esListo = n.estado==='listo_cierre';
    return `<div class="list-item ${nivelClass(n.nivel)}">
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px">
        ${modTag(n._m)}<span class="badge-estado ${nivelBadge(n.nivel)}">${n.nivel}</span>
        <span class="badge-estado ${estadoBadge(n.estado)}">${estadoLabel(n.estado)}</span>
      </div>
      <div class="list-item-title">${n.tipo} ${n.area?'· '+n.area:''}</div>
      <div class="list-item-sub">${n.descripcion||''}</div>
      <div class="list-item-sub" style="margin-top:2px">${ffd(n.creado_en)}</div>
      <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
        <button class="btn-sm btn-secondary" onclick="verDetNov('${n.id}','${n._m}')">Ver detalle</button>
        ${esActiva?`<button class="btn-sm btn-warning" onclick="marcarListoCierre('${n.id}','${n._m}')">📤 Marcar listo cierre</button>`:''}
        ${esListo?`<button class="btn-sm btn-success" onclick="abrirCierreNov('${n.id}','${n._m}')">🔒 Cerrar</button>`:''}
      </div>
    </div>`;
  }).join('');
}

window.marcarListoCierre = async function(id, mod) {
  try {
    // FIX: escribe AMBOS estado y status para compatibilidad con páginas viejas
    await updateDoc(doc(db, colNov(mod), id), {
      estado: 'listo_cierre',
      status: 'EN_ATENCION',
      marcado_listo_por: S.uid,
      marcado_listo_nombre: S.nombre,
      marcado_listo_en: serverTimestamp()
    });
    toast('✅ Marcada lista para cierre');
  } catch (e) { console.error(e); toast('Error', 'error'); }
};

window.abrirCierreNov = function(id, mod){
  const lista = mod==='pool'?S.novPool:mod==='gym'?S.novGym:mod==='mtto'?S.novMtto:S.novSeg;
  const n = lista.find(x=>x.id===id); if(!n) return;
  S.novSel={...n,_m:mod};
  document.getElementById('cerrar-nov-titulo').textContent = `${n.nivel} · ${n.tipo} ${n.area?'· '+n.area:''}`;
  document.getElementById('cerrar-nov-comentario').value='';

  // FIX: si la novedad suspendió un servicio, mostrar aviso de reactivación
  const reactivarHint = document.getElementById('cerrar-nov-reactivar');
  const haySuspension = (mod === 'pool' && S.poolEstado.suspendida === true) ||
                        (mod === 'gym' && S.gymEstado.suspendida === true);
  reactivarHint.style.display = haySuspension && (n.nivel||'').includes('crit') ? 'block' : 'none';

  document.getElementById('modal-cerrar-nov').classList.add('open');
};

window.confirmarCierreFinal = async function(){
  const comentario = document.getElementById('cerrar-nov-comentario').value.trim();
  if(!comentario){ toast('Escribe un comentario de cierre', 'error'); return; }
  if(!S.novSel) return;
  try{
    // FIX: escribe AMBOS estado y status
    await updateDoc(doc(db,colNov(S.novSel._m),S.novSel.id),{
      estado:'cerrada',
      status:'CERRADO',
      comentario_cierre:comentario,
      cerrado_por:S.uid,
      cerrado_por_nombre:S.nombre,
      cerrado_en:serverTimestamp()
    });

    // FIX: si era una novedad crítica que suspendió el servicio, reactivar automáticamente
    const esCritica = (S.novSel.nivel||'').includes('crit');
    if (esCritica && S.novSel._m === 'pool' && S.poolEstado.suspendida === true) {
      await setDoc(doc(db,'pool_estado',fechaHoy()),{
        suspendida: false,
        reactivado_motivo: 'Cierre de novedad crítica: '+comentario.substring(0,100),
        reactivado_por: S.nombre,
        reactivado_en: serverTimestamp()
      },{ merge: true });
    }
    if (esCritica && S.novSel._m === 'gym' && S.gymEstado.suspendida === true) {
      await setDoc(doc(db,'gym_estado',fechaHoy()),{
        suspendida: false,
        reactivado_motivo: 'Cierre de novedad crítica: '+comentario.substring(0,100),
        reactivado_por: S.nombre,
        reactivado_en: serverTimestamp()
      },{ merge: true });
    }

    cerrarModal('modal-cerrar-nov');
    toast('✅ Novedad cerrada');
  }catch(e){ console.error(e); toast('Error al cerrar', 'error'); }
};

window.verDetNov = function(id, mod){
  const lista = mod==='pool'?S.novPool:mod==='gym'?S.novGym:mod==='mtto'?S.novMtto:S.novSeg;
  const n = lista.find(x=>x.id===id); if(!n) return;
  S.novSel={...n,_m:mod};
  const esActiva = n.estado==='abierta'||n.estado==='en_atencion';
  const esListo = n.estado==='listo_cierre';
  document.getElementById('modal-nov-body').innerHTML = `
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">
      ${modTag(mod)}<span class="badge-estado ${nivelBadge(n.nivel)}">${n.nivel}</span>
      <span class="badge-estado ${estadoBadge(n.estado)}">${estadoLabel(n.estado)}</span>
    </div>
    <div class="form-group"><span class="label">Tipo / Área</span><div style="font-weight:600">${n.tipo} ${n.area?'· '+n.area:''}</div></div>
    <div class="form-group"><span class="label">Descripción</span><div style="font-size:13px">${n.descripcion||'Sin descripción'}</div></div>
    <div class="form-group"><span class="label">Registrado por</span><div style="font-size:13px">${n.creado_por||n.vig_nombre||n.piscinero_nombre||n.operador_nombre||n.reportado_por_nombre||'—'} · ${ffd(n.creado_en)}</div></div>
    ${n.foto_url||n.foto_evidencia?`<img src="${n.foto_url||n.foto_evidencia}" style="width:100%;border-radius:8px;max-height:200px;object-fit:cover;margin-top:8px;cursor:pointer" onclick="window.open('${n.foto_url||n.foto_evidencia}','_blank')">`:''}`;
  document.getElementById('modal-nov-footer').innerHTML =
    `<button class="btn btn-secondary btn-sm" style="flex:1" onclick="cerrarModal('modal-nov-detalle')">Cerrar</button>
    ${esActiva?`<button class="btn btn-warning btn-sm" style="flex:1" onclick="cerrarModal('modal-nov-detalle');marcarListoCierre('${n.id}','${mod}')">Marcar listo</button>`:''}
    ${esListo?`<button class="btn btn-success btn-sm" style="flex:1" onclick="cerrarModal('modal-nov-detalle');abrirCierreNov('${n.id}','${mod}')">Cerrar definitivamente</button>`:''}`;
  document.getElementById('modal-nov-detalle').classList.add('open');
};

// ─── TAREAS ───────────────────────────────────────────────
window.setFiltroTarea = function(el){
  S.filtroTarea=el.dataset.val;
  document.querySelectorAll('#sec-tareas .chip').forEach(c=>c.classList.remove('active')); el.classList.add('active');
  renderTareas();
};

window.abrirModalTarea = function(){
  document.getElementById('tarea-titulo').value='';
  document.getElementById('tarea-desc').value='';
  document.getElementById('tarea-asignado').value='';
  document.getElementById('tarea-fecha-limite').value='';
  document.getElementById('modal-tarea').classList.add('open');
};

window.guardarTarea = async function(){
  const titulo = document.getElementById('tarea-titulo').value.trim();
  const asignado = document.getElementById('tarea-asignado').value;
  if(!titulo){ toast('Escribe un título', 'error'); return; }
  if(!asignado){ toast('Selecciona a quién asignar', 'error'); return; }
  try{
    await addDoc(collection(db,'tareas_mantenimiento'),{
      titulo,
      descripcion:document.getElementById('tarea-desc').value.trim(),
      area:document.getElementById('tarea-area').value,
      prioridad:document.getElementById('tarea-prioridad').value,
      asignado_a:asignado,
      estado:'pendiente',
      fecha:fechaHoy(),
      fecha_limite:document.getElementById('tarea-fecha-limite').value||null,
      creado_por:S.uid,
      creado_por_nombre:S.nombre,
      creado_en:serverTimestamp()
    });
    cerrarModal('modal-tarea');
    toast('✅ Tarea creada');
  }catch(e){ console.error(e); toast('Error al guardar', 'error'); }
};

function renderTareas(){
  let lista = [...S.tareas];
  if(S.filtroTarea!=='todas') lista=lista.filter(t=>t.estado===S.filtroTarea);
  const cont = document.getElementById('lista-tareas');
  if(!lista.length){ cont.innerHTML='<div class="empty"><div class="icon">🔧</div><p>Sin tareas</p></div>'; return; }
  const asigColor = {todero:'#2563eb',aseo:'#059669',seguridad:'#b45309'};
  const asigLabel = {todero:'🔧 Todero',aseo:'🧹 Aseo',seguridad:'👮 Seguridad'};
  const estColor = {pendiente:'#94a3b8',en_proceso:'#f59e0b',completada_pendiente_revision:'#7c3aed',aprobada:'#10b981',rechazada:'#ef4444',cerrada:'#475569'};
  const estLabel = {pendiente:'⏳ Pendiente',en_proceso:'🔄 En proceso',completada_pendiente_revision:'🔍 Para verificar',aprobada:'✅ Aprobada',rechazada:'↩️ Devuelta',cerrada:'🔒 Cerrada'};
  cont.innerHTML = lista.map(t=>`
    <div class="list-item" style="border-left:4px solid ${estColor[t.estado]||'#94a3b8'}">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
        <div style="flex:1">
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px">
            <span class="badge-estado badge-${t.prioridad==='alta'?'critico':t.prioridad==='media'?'medio':'bajo'}">${t.prioridad}</span>
            <span style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:6px;background:#eff6ff;color:${asigColor[t.asignado_a]||'#374151'}">${asigLabel[t.asignado_a]||t.asignado_a}</span>
          </div>
          <div class="list-item-title">${t.titulo}</div>
          <div class="list-item-sub">${t.area||'—'} ${t.descripcion?'· '+t.descripcion.substring(0,60):''}</div>
        </div>
        <div style="font-size:12px;font-weight:600;color:${estColor[t.estado]};white-space:nowrap">${estLabel[t.estado]||t.estado}</div>
      </div>
      ${t.estado==='completada_pendiente_revision'?`
      <div style="margin-top:8px">
        <div style="background:#f5f3ff;border:1px solid #c4b5fd;border-radius:8px;padding:8px;font-size:12px;margin-bottom:8px">
          <div style="font-weight:600;color:var(--purple)">📋 Completada por ${t.completado_por_nombre||'—'}</div>
          ${t.completado_notas?`<div style="margin-top:2px">${t.completado_notas}</div>`:''}
          ${t.foto_evidencia?`<img src="${t.foto_evidencia}" style="margin-top:6px;width:100%;max-height:120px;object-fit:cover;border-radius:6px;cursor:pointer" onclick="window.open('${t.foto_evidencia}','_blank')">`:''}
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          <button class="btn-sm btn-success" onclick="aprobarTarea('${t.id}')">✅ Aprobar</button>
          <button class="btn-sm btn-warning" onclick="abrirDevolverTarea('${t.id}')">↩️ Devolver con diagnóstico</button>
        </div>
      </div>`:''}
      ${t.estado==='rechazada'?`
        <div style="background:#fef2f2;border:1px solid #fca5a5;border-radius:8px;padding:8px;font-size:12px;margin-top:8px;color:#b91c1c">
          <strong>Devuelta:</strong> ${t.rechazo_motivo||'—'}
        </div>`:''}
    </div>`).join('');
}

window.aprobarTarea = async function(id){
  try{
    await updateDoc(doc(db,'tareas_mantenimiento',id),{
      estado:'aprobada',
      aprobado_por:S.uid,
      aprobado_por_nombre:S.nombre,
      aprobado_en:serverTimestamp()
    });
    toast('✅ Tarea aprobada');
  }catch(e){ console.error(e); toast('Error', 'error'); }
};

window.abrirDevolverTarea = function(id) {
  S.tareaSel = id;
  document.getElementById('devolver-motivo').value = '';
  document.getElementById('modal-devolver').classList.add('open');
};

window.confirmarDevolver = async function() {
  const motivo = document.getElementById('devolver-motivo').value.trim();
  if (!motivo) { toast('Escribe el mensaje al operario', 'error'); return; }
  try {
    await updateDoc(doc(db,'tareas_mantenimiento',S.tareaSel),{
      estado: 'rechazada',
      rechazo_motivo: motivo,
      rechazado_por: S.uid,
      rechazado_por_nombre: S.nombre,
      rechazado_en: serverTimestamp()
    });
    cerrarModal('modal-devolver');
    toast('↩️ Tarea devuelta al operario');
  } catch (e) { console.error(e); toast('Error', 'error'); }
};

// ─── PQR COORDINADOR ──────────────────────────────────────
window.setFiltroPQRCoord = function(el) {
  S.filtroPQRCoord = el.dataset.val;
  document.querySelectorAll('#filtro-pqr-coord-chips .chip').forEach(c=>c.classList.remove('active')); el.classList.add('active');
  renderPQRCoord();
};

function renderPQRCoord() {
  let lista = [...S.pqrs];
  const f = S.filtroPQRCoord;
  if (f === 'Crítico') lista = lista.filter(p=>p.prioridad==='Crítico');
  else if (f !== 'todas') lista = lista.filter(p=>p.estado===f);

  const cont = document.getElementById('lista-pqr-coord');
  if (!lista.length) { cont.innerHTML='<div class="empty"><div class="icon">💬</div><p>Sin PQRs</p></div>'; return; }

  const tipoIcon = {consulta:'❓',queja:'😠',reclamo:'📢',sugerencia:'💡',solicitud:'📋',Petición:'📝',Queja:'😤',Reclamo:'⚠️',Sugerencia:'💡'};
  const estColor = {abierto:'#ef4444',en_gestion:'#f59e0b',listo_cierre:'#7c3aed',cerrado:'#10b981'};
  const estLabel = {abierto:'Abierto',en_gestion:'En gestión',listo_cierre:'Listo cierre',cerrado:'Cerrado'};
  const prioColor = {'Crítico':'#ef4444','Medio':'#f59e0b','Bajo':'#10b981'};
  const prioBg = {'Crítico':'#fee2e2','Medio':'#fef3c7','Bajo':'#d1fae5'};

  cont.innerHTML = lista.map(p=>`
    <div class="list-item" style="border-left:4px solid ${estColor[p.estado]||'#94a3b8'}">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
        <div style="flex:1">
          <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:4px">
            <span style="font-size:16px">${tipoIcon[p.tipo]||'📋'}</span>
            <span style="font-weight:700;font-size:12px;text-transform:capitalize">${p.tipo||'—'}</span>
            ${p.prioridad?`<span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px;background:${prioBg[p.prioridad]||'#f1f5f9'};color:${prioColor[p.prioridad]||'#475569'}">${p.prioridad}</span>`:''}
            ${p.asignado_a&&p.asignado_a!=='Asistente'?`<span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px;background:#f3e8ff;color:#7c3aed">${p.asignado_a}</span>`:''}
          </div>
          <div class="list-item-title">${p.nombre_residente||p.nombre||'—'} · ${p.torre_apto||'—'}</div>
          <div class="list-item-sub">${(p.descripcion||'').substring(0,80)}${(p.descripcion||'').length>80?'...':''}</div>
          <div class="list-item-sub" style="margin-top:2px">${ffd(p.creado_en)}</div>
        </div>
        <span style="font-size:11px;font-weight:600;padding:3px 8px;border-radius:12px;background:${estColor[p.estado]||'#94a3b8'}22;color:${estColor[p.estado]||'#475569'};white-space:nowrap">${estLabel[p.estado]||p.estado}</span>
      </div>
      <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
        ${p.estado!=='cerrado'?`<button class="btn-sm btn-primary" onclick="gestionarPQRCoord('${p.id}')">Gestionar</button>`:''}
      </div>
    </div>`).join('');
}

window.gestionarPQRCoord = function(id) {
  const p = S.pqrs.find(x=>x.id===id); if(!p) return;
  S.pqrCoordSel = p;
  const tipoIcon = {consulta:'❓',queja:'😠',reclamo:'📢',sugerencia:'💡',solicitud:'📋',Petición:'📝',Queja:'😤',Reclamo:'⚠️',Sugerencia:'💡'};
  const prioColor = {'Crítico':'#ef4444','Medio':'#f59e0b','Bajo':'#10b981'};
  const prioBg = {'Crítico':'#fee2e2','Medio':'#fef3c7','Bajo':'#d1fae5'};
  document.getElementById('pqr-coord-body').innerHTML = `
    <div class="form-group"><span class="label">Tipo · Torre/Apto</span><div style="font-weight:600">${tipoIcon[p.tipo]||''} ${p.tipo} · ${p.torre_apto||'—'}</div></div>
    <div class="form-group"><span class="label">Residente</span><div>${p.nombre_residente||p.nombre||'—'} · ${ffd(p.creado_en)}</div></div>
    <div class="form-row" style="gap:8px">
      <div class="form-group"><span class="label">Prioridad</span><div style="font-weight:600;color:${prioColor[p.prioridad]||'inherit'}">${p.prioridad||'—'}</div></div>
      <div class="form-group"><span class="label">Asignado a</span><div style="font-weight:600">${p.asignado_a||'Asistente'}</div></div>
    </div>
    <div class="form-group"><span class="label">Descripción</span><div style="font-size:13px">${p.descripcion||'Sin descripción'}</div></div>
    <hr style="border-color:var(--border);margin:12px 0">
    <div class="form-group"><label class="label">Respuesta / Gestión</label>
      <textarea class="input" id="pqr-coord-resp" rows="3" placeholder="Escribe la respuesta o acción tomada...">${p.respuesta||''}</textarea>
    </div>
    <div class="form-group"><label class="label">Cambiar estado</label>
      <select class="select" id="pqr-coord-estado">
        <option value="abierto" ${p.estado==='abierto'?'selected':''}>Abierto</option>
        <option value="en_gestion" ${p.estado==='en_gestion'?'selected':''}>En gestión</option>
        <option value="listo_cierre" ${p.estado==='listo_cierre'?'selected':''}>Listo para cierre</option>
        <option value="cerrado" ${p.estado==='cerrado'?'selected':''}>Cerrado</option>
      </select>
    </div>`;
  document.getElementById('pqr-coord-footer').innerHTML =
    `<button class="btn btn-secondary btn-sm" style="flex:1" onclick="cerrarModal('modal-pqr-coord')">Cancelar</button>
     <button class="btn btn-primary btn-sm" style="flex:1" onclick="guardarGestionPQRCoord()">Guardar</button>`;
  document.getElementById('modal-pqr-coord').classList.add('open');
};

window.guardarGestionPQRCoord = async function() {
  const respuesta = document.getElementById('pqr-coord-resp').value.trim();
  const nuevoEstado = document.getElementById('pqr-coord-estado').value;
  if (!S.pqrCoordSel) return;
  try {
    await updateDoc(doc(db,'pqr',S.pqrCoordSel.id), {
      respuesta: respuesta||null,
      estado: nuevoEstado,
      gestionado_por: S.uid,
      gestionado_por_nombre: S.nombre,
      gestionado_en: serverTimestamp()
    });
    cerrarModal('modal-pqr-coord');
    toast('✅ PQR actualizada');
  } catch(e) { console.error(e); toast('Error', 'error'); }
};

// ─── NAV ──────────────────────────────────────────────────
window.navTo = function(sec,btn){
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));
  document.getElementById('sec-'+sec).classList.add('active');
  btn.classList.add('active');
};

// ─── START ────────────────────────────────────────────────
iniciarListeners();
</script>
</body>
