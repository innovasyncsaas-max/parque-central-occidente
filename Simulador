// LIMPIAR DATOS
window.limpiarDatos = async function() {
  if(!confirm(`¿Eliminar TODOS los datos de hoy (${HOY}) en Firebase? Esta acción no se puede deshacer.`)) return;

  const colecciones = ['reservas','accesos','tareas_mantenimiento','seg_novedades','pool_novedades','gym_novedades','novedades_mantenimiento','pqr','correspondencia','mora'];
  log('Limpiando datos del día ' + HOY + '...', 'info');
  setProgress('Limpiando...', 10);

  let total = 0;
  for (const col of colecciones) {
    try {
      const snap = await getDocs(query(collection(db, col), where('fecha', '==', HOY)));
      for (const d of snap.docs) { await deleteDoc(d.ref); total++; }
      log(`✓ ${col}: ${snap.docs.length} documentos eliminados`, 'ok');
    } catch(e) {
      log(`⚠️ ${col}: ${e.message}`, 'err');
    }
  }

  setProgress('Limpieza completa', 100);
  log(`🗑️ Total: ${total} documentos eliminados`, 'info');
  setStatus(`🗑️ ${total} documentos eliminados de la fecha ${HOY}`);
  document.getElementById('btn-seed').textContent = '🌱 Generar datos del día de hoy';
};
