          <input class="url-input" id="url-operador-piscina" placeholder="https://..." oninput="guardarUrl('operador-piscina',this.value)">
          <button class="open-btn" onclick="abrirModulo('operador-piscina','Operador Sim','operador_pool_sim')">Abrir</button>
        </div>
        <div class="role-card">
          <div class="role-icon">🔧</div>
          <div class="role-name">Todero</div>
          <input class="url-input" id="url-todero" placeholder="https://..." oninput="guardarUrl('todero',this.value)">
          <button class="open-btn" onclick="abrirModulo('todero','Todero Test','todero_sim')">Abrir</button>
        </div>
        <div class="role-card">
          <div class="role-icon">📊</div>
          <div class="role-name">Coordinador</div>
          <input class="url-input" id="url-coordinador" placeholder="https://..." oninput="guardarUrl('coordinador',this.value)">
          <button class="open-btn" onclick="abrirModulo('coordinador','Coord Sim','coord_sim')">Abrir</button>
        </div>
        <div class="role-card">
          <div class="role-icon">📋</div>
          <div class="role-name">Asistente</div>
          <input class="url-input" id="url-asistente" placeholder="https://..." oninput="guardarUrl('asistente',this.value)">
          <button class="open-btn" onclick="abrirModulo('asistente','Asistente Sim','asist_sim')">Abrir</button>
        </div>
        <div class="role-card">
          <div class="role-icon">🛡️</div>
          <div class="role-name">Vigilante</div>
          <input class="url-input" id="url-vigilante" placeholder="https://..." oninput="guardarUrl('vigilante',this.value)">
          <button class="open-btn" onclick="abrirModulo('vigilante','Vigilante Sim','vig_sim')">Abrir</button>
        </div>
        <div class="role-card">
          <div class="role-icon">⭐</div>
          <div class="role-name">SUPSEC</div>
          <input class="url-input" id="url-supsec" placeholder="https://..." oninput="guardarUrl('supsec',this.value)">
          <button class="open-btn" onclick="abrirModulo('supsec','SUPSEC Sim','supsec_sim')">Abrir</button>
        </div>
        <div class="role-card">
          <div class="role-icon">👑</div>
          <div class="role-name">Administrador</div>
          <input class="url-input" id="url-administrador" placeholder="https://..." oninput="guardarUrl('administrador',this.value)">
          <button class="open-btn" onclick="abrirModulo('administrador','Admin Sim','admin_sim')">Abrir</button>
        </div>
      </div>
    </div>
  </div>

  <!-- SEED DE DATOS -->
  <div class="card">
    <div class="card-header">
      <span style="font-size:18px">🌱</span>
      <h2>Paso 2 — Generar datos del día de simulación</h2>
    </div>

    <div class="status-strip" id="status-strip"></div>

    <div class="card-body">
      <div class="stats-row" id="stats-row" style="display:none">
        <div class="stat-pill ok" id="pill-reservas">✓ Reservas</div>
        <div class="stat-pill ok" id="pill-accesos">✓ Accesos</div>
        <div class="stat-pill ok" id="pill-tareas">✓ Tareas</div>
