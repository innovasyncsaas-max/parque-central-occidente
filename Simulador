        <div class="stat-pill ok" id="pill-corr">✓ Correspondencia</div>
      </div>

      <div class="progress-wrap" id="progress-wrap" style="display:none">
        <div class="progress-label"><span id="progress-txt">Preparando...</span><span id="progress-pct">0%</span></div>
        <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
      </div>

      <div style="display:flex;gap:10px;margin-bottom:12px">
        <button class="btn-seed btn-seed-primary" id="btn-seed" onclick="seedData()" style="flex:2">
          🌱 Generar datos del día de hoy
        </button>
        <button class="btn-seed btn-seed-danger" onclick="limpiarDatos()" style="flex:1">
          🗑️ Limpiar datos de hoy
        </button>
      </div>

      <div class="log-box" id="log-box"></div>

      <p style="font-size:12px;color:var(--muted);margin-top:10px">
        Los datos se crean con fecha de <strong>hoy</strong>. Al abrir los módulos verás todo sincronizado en tiempo real.
      </p>
    </div>
  </div>

  <!-- ESCENARIO DEL DÍA -->
  <div class="card">
    <div class="card-header">
      <span style="font-size:18px">🎬</span>
      <h2>Paso 3 — Guión del día de simulación</h2>
    </div>
    <div class="card-body">
      <p style="font-size:13px;color:var(--muted);margin-bottom:16px">Sigue este guión con las pestañas abiertas. Cada acción es visible en tiempo real en los otros módulos.</p>

      <div class="scenario-step">
        <div class="step-num">1</div>
        <div class="step-icon">🏊</div>
        <div>
          <div class="step-role">Piscinero · 8:00am</div>
          <div class="step-action">Completar el checklist de apertura</div>
          <div class="step-desc">Entra al módulo Piscinero → Checklist → Marca los 12 ítems → Guarda. Aparece ✅ en el dashboard del Coordinador.</div>
        </div>
      </div>

      <div class="scenario-step">
        <div class="step-num">2</div>
        <div class="step-icon">🛡️</div>
        <div>
          <div class="step-role">Vigilante · 8:15am</div>
          <div class="step-action">Registrar visitante + primera ronda</div>
          <div class="step-desc">Entra al módulo Vigilante → Acceso → Registra un visitante → Luego Rondas → Selecciona "Perimetral" → Toma foto → Guarda. El SUPSEC lo ve en tiempo real.</div>
        </div>
      </div>

      <div class="scenario-step">
        <div class="step-num">3</div>
        <div class="step-icon">🔧</div>
        <div>
          <div class="step-role">Todero · 9:00am</div>
          <div class="step-action">Iniciar y completar la tarea asignada</div>
          <div class="step-desc">La tarea "Reparar llave de paso piso 3" ya está creada. Todero → Mis Tareas → Iniciar → (hacer el trabajo) → Completar → Foto + notas. El Coordinador recibe la notificación.</div>
        </div>
      </div>

      <div class="scenario-step">
        <div class="step-num">4</div>
        <div class="step-icon">📊</div>
        <div>
          <div class="step-role">Coordinador · 9:15am</div>
          <div class="step-action">Verificar tarea → Aprobar o devolver</div>
          <div class="step-desc">Coordinador → Tareas → "Para verificar" → Ver foto y notas del Todero → Aprobar ✅. O si algo falta, usar "↩️ Devolver con diagnóstico". El Todero recibe el mensaje al instante.</div>
        </div>
      </div>

      <div class="scenario-step">
        <div class="step-num">5</div>
        <div class="step-icon">🏊</div>
        <div>
          <div class="step-role">Operador Piscina · 10:00am</div>
          <div class="step-action">Abrir piscina + registrar primera ronda</div>
          <div class="step-desc">Operador → Apertura → Foto + pH + cloro + checklist → "Abrir piscina". Luego Aforo → registra entradas con ➕. El Piscinero ve el aforo en su dashboard.</div>
        </div>
      </div>

      <div class="scenario-step">
        <div class="step-num">6</div>
        <div class="step-icon">🚨</div>
        <div>
          <div class="step-role">Piscinero · 11:00am</div>
          <div class="step-action">Reportar novedad CRÍTICA (suspensión)</div>
          <div class="step-desc">Piscinero → Novedades → Severidad CRÍTICO → "Cloro fuera de rango peligroso" → Confirmar. Aparece banner rojo en Coordinador, SUPSEC y Administrador. La piscina queda SUSPENDIDA.</div>
        </div>
      </div>

      <div class="scenario-step">
        <div class="step-num">7</div>
        <div class="step-icon">📊</div>
        <div>
          <div class="step-role">Coordinador · 11:05am</div>
          <div class="step-action">Ver suspensión → Reactivar servicio</div>
          <div class="step-desc">Coordinador → Servicios → Banner rojo "Piscina SUSPENDIDA" → Botón "▶ Reactivar" → Escribir motivo → Confirmar. El Piscinero y Operador ven la piscina activa de nuevo.</div>
        </div>
      </div>

      <div class="scenario-step">
        <div class="step-num">8</div>
        <div class="step-icon">📋</div>
        <div>
          <div class="step-role">Asistente · 2:00pm</div>
          <div class="step-action">Gestionar PQR de residente + correspondencia</div>
          <div class="step-desc">Ya hay una PQR creada. Asistente → PQR → "Gestionar" → Escribe respuesta → Cambia estado a "En gestión". Luego Mora/Correspondencia → Marcar paquete como entregado.</div>
        </div>
      </div>

      <div class="scenario-step">
        <div class="step-num">9</div>
        <div class="step-icon">📊</div>
        <div>
          <div class="step-role">Coordinador · 5:00pm</div>
          <div class="step-action">Cerrar novedades del día</div>
          <div class="step-desc">Coordinador → Novedades → filtro "Listo cierre" → Cerrar cada novedad con comentario. El sistema queda limpio para el día siguiente.</div>
        </div>
      </div>

    </div>
  </div>

  <!-- DATOS CREADOS -->
  <div class="card">
    <div class="card-header">
      <span style="font-size:18px">📦</span>
      <h2>¿Qué datos se crean al hacer Seed?</h2>
    </div>
    <div class="card-body">
      <div class="grid-2">
        <div>
          <div class="section-title">Reservas de piscina</div>
          <div style="font-size:13px;line-height:1.8;color:var(--muted)">
            • Carlos Rueda · T1-302 · 10:00am · 3 personas<br>
            • María Gómez · T2-501 · 2:00pm · 5 personas<br>
            • Pedro Torres · T3-108 · 4:00pm · 2 personas
          </div>
        </div>
        <div>
          <div class="section-title">Accesos de seguridad</div>
          <div style="font-size:13px;line-height:1.8;color:var(--muted)">
            • Visitante: Juan López → T1-101<br>
            • Domicilio: Rappi → T2-405<br>
            • Vehículo: ABC-123 Mazda Rojo
          </div>
        </div>
        <div>
          <div class="section-title">Tareas de mantenimiento</div>
          <div style="font-size:13px;line-height:1.8;color:var(--muted)">
            • Reparar llave de paso piso 3 (Alta · Todero)<br>
            • Limpieza zona BBQ post-evento (Media · Aseo)<br>
            • Revisar iluminación parqueadero (Baja · Todero)
          </div>
        </div>
        <div>
          <div class="section-title">Novedades del sistema</div>
          <div style="font-size:13px;line-height:1.8;color:var(--muted)">
            • Seguridad: Ruido excesivo T3-202 (Media)<br>
            • Piscina: Fuga menor en filtro (Media)<br>
            • PQR: Queja por ruido de vecino
          </div>
        </div>
        <div>
          <div class="section-title">Correspondencia</div>
          <div style="font-size:13px;line-height:1.8;color:var(--muted)">
            • Paquete Amazon → T1-201<br>
            • Carta Bancolombia → T2-304<br>
            • Documento legal → T3-501
          </div>
        </div>
        <div>
          <div class="section-title">Mora (control)</div>
          <div style="font-size:13px;line-height:1.8;color:var(--muted)">
            • T1-401 Hernández · 2 meses<br>
            • T2-203 Vargas · 1 mes<br>
            • T3-302 Mejía · Al día ✅
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<script type="module">
import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js';
import { getFirestore, collection, addDoc, setDoc, doc, getDocs, query, where, deleteDoc, serverTimestamp }
  from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js';

const firebaseConfig = {
  apiKey: "AIzaSyD3fprcNthKNU8fguyxdHC60pQ2T0PH5Ek",
  authDomain: "registro-residentes.firebaseapp.com",
  projectId: "registro-residentes",
  storageBucket: "registro-residentes.firebasestorage.app",
  messagingSenderId: "646123326163",
  appId: "1:646123326163:web:8b35b955e7b3692536a226"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

// FIX: zona horaria Bogotá
function fechaHoy() {
  const d = new Date();
  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
  return d.toISOString().split('T')[0];
}

const HOY = fechaHoy();
let totalSteps = 0;
let doneSteps = 0;

// LOG
function log(msg, tipo='info') {
  const box = document.getElementById('log-box');
  box.classList.add('show');
  const line = document.createElement('div');
  line.className = `log-line ${tipo}`;
  line.textContent = `[${new Date().toLocaleTimeString('es-CO')}] ${msg}`;
  box.appendChild(line);
  box.scrollTop = box.scrollHeight;
}

function setProgress(txt, pct) {
  document.getElementById('progress-wrap').style.display = 'block';
  document.getElementById('progress-txt').textContent = txt;
  document.getElementById('progress-pct').textContent = pct + '%';
  document.getElementById('progress-fill').style.width = pct + '%';
}

function setStatus(msg, esError = false) {
  const strip = document.getElementById('status-strip');
  strip.textContent = msg;
  strip.classList.add('show');
  strip.classList.toggle('error', esError);
}

// GUARDAR URLs EN LOCALSTORAGE
window.guardarUrl = function(modulo, url) {
  localStorage.setItem(`pco3_sim_url_${modulo}`, url);
};

// ABRIR MÓDULO EN NUEVA PESTAÑA
window.abrirModulo = function(modulo, nombre, uid) {
  const input = document.getElementById(`url-${modulo}`);
  const url = (input && input.value.trim()) || localStorage.getItem(`pco3_sim_url_${modulo}`) || '';
  if (!url) {
    alert(`Pega primero la URL del módulo "${modulo}"`);
    return;
  }
  const sep = url.includes('?') ? '&' : '?';
  window.open(`${url}${sep}uid=${uid}&nombre=${encodeURIComponent(nombre)}&rol=${modulo}`, '_blank');
};

// CARGAR URLs GUARDADAS
function cargarUrlsGuardadas() {
  const modulos = ['piscinero','operador-piscina','todero','coordinador','asistente','vigilante','supsec','administrador'];
  modulos.forEach(m => {
    const saved = localStorage.getItem(`pco3_sim_url_${m}`);
    const el = document.getElementById(`url-${m}`);
    if (saved && el) el.value = saved;
  });
}
