  <!-- PASO 10: CONFIRMACIÓN -->
  <div class="step" id="step-10">
    <div class="step-header">
      <div class="step-icon">✅</div>
      <div class="step-title">Confirmar Registro</div>
      <div class="step-sub">Revisa que todo esté correcto antes de enviar.</div>
    </div>
    <div class="card">
      <div class="card-title">Resumen</div>
      <div id="resumen-contenido" style="font-size:13px;line-height:2;color:var(--text2);"></div>
    </div>
    <div class="error-msg" id="err-envio">Hubo un error al enviar. Por favor intenta de nuevo.</div>
    <div class="btn-row">
      <button class="btn-back" onclick="prevStep('10')">← Atrás</button>
      <button class="btn-next" onclick="submitForm()">📤 Enviar Registro</button>
    </div>
  </div>

  <!-- ÉXITO -->
  <div class="step" id="step-success">
    <div class="success-screen">
      <div class="success-icon">🏠</div>
      <div class="success-title">¡Gracias por tu actualización!</div>
      <div class="success-text">
        Ahora estás registrado en nuestra base de datos.<br><br>
        Recuerda que el <strong>número de teléfono que registraste</strong> será el contacto de notificación y el canal principal de comunicación entre la administración y quienes habitan el apartamento.<br><br>
        En caso de <strong>cambio de propietario, mudanza o cambio de teléfono</strong>, por favor solicita actualizar tus datos directamente en administración.<br><br>
        ¡Bienvenido a tu comunidad! 🌟
      </div>
    </div>
  </div>

</div>

<!-- FIREBASE -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
import { getFirestore, collection, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyD3fprcNthKNU8fguyxdHC60pQ2T0PH5Ek",
  authDomain: "registro-residentes.firebaseapp.com",
  projectId: "registro-residentes",
  storageBucket: "registro-residentes.firebasestorage.app",
  messagingSenderId: "646123326163",
  appId: "1:646123326163:web:8b35b955e7b3692536a226"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

window.saveToFirestore = async function(data) {
  try {
    const docRef = await addDoc(collection(db, "residentes"), {
      ...data,
      fechaRegistro: serverTimestamp()
    });
    return docRef.id;
  } catch(e) {
    console.error("Error guardando:", e);
    throw e;
  }
};
</script>

<script>
const STEP_TITLES = {
  '1':'Términos','2':'Inmueble','3':'Propietario','4':'Residentes',
  '5a':'Composición','5b':'Residentes','6':'Mascotas',
  '7':'Carros','8':'Motos','9':'Bicicletas','10':'Confirmación'
};
let habitaPropietario = '';

// ── Generador dinámico de fichas por persona ──────────────────────────────
const TIPO_DOC_MENOR = ['Tarjeta de Identidad','Registro Civil','Pasaporte'];
const TIPO_DOC_ADULTO = ['Cédula de Ciudadanía','Cédula de Extranjería','Pasaporte'];

function tipoDocOptions(tipos) {
  return tipos.map(t=>`<option value="${t}">${t}</option>`).join('');
}

function personaCardHTML(tipo, step, idx) {
  const esMenor = tipo === 'menores';
  const esAdultoM = tipo === 'adultos-m';
  const prefix = `${tipo}-${step}-p${idx}`;
  const tiposDoc = esMenor ? tipoDocOptions(TIPO_DOC_MENOR) : tipoDocOptions(TIPO_DOC_ADULTO);

  const emojis = { menores:'👶', adultos:'🧑', 'adultos-m':'👴' };
  const labels = { menores:'Menor', adultos:'Adulto', 'adultos-m':'Adulto Mayor' };

  // Rango de fecha de nacimiento según categoría
  const hoy = new Date().toISOString().split('T')[0];
  const maxFechaMenor = hoy; // hasta hoy (validación de <18 se hace por lógica)
  const minFechaMenor = (() => { const d = new Date(); d.setFullYear(d.getFullYear()-17); return d.toISOString().split('T')[0]; })();
  const maxFechaAdultoM = (() => { const d = new Date(); d.setFullYear(d.getFullYear()-60); return d.toISOString().split('T')[0]; })();

  return `
    <div class="persona-card" id="card-${prefix}">
      <div class="persona-card-title">${emojis[tipo]} ${labels[tipo]} ${idx}</div>
      <div class="field">
        <label class="field-label">Nombre completo</label>
        <input type="text" class="field-input" id="${prefix}-nombre" placeholder="Nombre y apellidos">
      </div>
      <div class="field">
        <label class="field-label">Tipo de documento</label>
        <select class="field-input" id="${prefix}-tipodoc">
          <option value="">-- Seleccionar --</option>
          ${tiposDoc}
        </select>
      </div>
      <div class="field">
        <label class="field-label">Número de documento</label>
        <input type="text" class="field-input" id="${prefix}-numdoc" placeholder="Número">
      </div>
      <div class="field">
        <label class="field-label">Fecha de nacimiento</label>
        <input type="date" class="field-input" id="${prefix}-fechanac"
          ${esMenor ? `min="${minFechaMenor}" max="${hoy}"` : ''}
          ${esAdultoM ? `max="${maxFechaAdultoM}"` : ''}
        >
      </div>
    </div>`;
}

window.generarPersonas = function(tipo, step, cantStr) {
  const cant = parseInt(cantStr) || 0;
  const container = document.getElementById(`personas-${tipo}-${step}`);
  const cantInput = document.getElementById(`cant-${tipo}-${step}`);
  if (!container) return;
  container.innerHTML = '';
  cantInput.value = cant;
  for (let i = 1; i <= cant; i++) {
    container.innerHTML += personaCardHTML(tipo, step, i);
  }
};

// ── Recolectar datos de personas por tipo ────────────────────────────────
function recolectarPersonas(tipo, step) {
  const cant = parseInt(document.getElementById(`cant-${tipo}-${step}`)?.value || '0');
  const arr = [];
  for (let i = 1; i <= cant; i++) {
    const prefix = `${tipo}-${step}-p${i}`;
    arr.push({
      nombre: v(`${prefix}-nombre`),
      tipoDoc: v(`${prefix}-tipodoc`),
      numDoc: v(`${prefix}-numdoc`),
      fechaNacimiento: v(`${prefix}-fechanac`)
    });
  }
  return arr;
}

// ── Navegación ───────────────────────────────────────────────────────────
function updateProgress(step) {
  const visible = ['1','2','3','4', habitaPropietario==='Sí'?'5a':'5b','6','7','8','9','10'];
  const idx = visible.indexOf(step);
  const total = visible.length;
  const pct = idx >= 0 ? Math.round(((idx+1)/total)*100) : 100;
  document.getElementById('progress-fill').style.width = pct+'%';
  document.getElementById('progress-title').textContent = STEP_TITLES[step]||'';
  document.getElementById('progress-count').textContent = idx>=0?`${idx+1} de ${total}`:'';
}

function showStep(step) {
  document.querySelectorAll('.step').forEach(s=>s.classList.remove('active'));
  document.getElementById('step-'+step).classList.add('active');
  updateProgress(step);
  window.scrollTo({top:0,behavior:'smooth'});
}

function nextStep(from) {
  hideAllErrors();
  if(from==='1') {
    const habeas = document.getElementById('acepta-habeas').checked;
    const terminos = document.getElementById('acepta-terminos').checked;
    if(!habeas || !terminos){showError('err-terminos');return;}
    showStep('2');
  } else if(from==='2') {
    if(!v('torre')||!v('apto')||!v('tiene-deposito')){showError('err-inmueble');return;}
    // Si tiene depósito, el número de depósito es obligatorio
    if(v('tiene-deposito')==='Sí' && !v('num-deposito')){showError('err-inmueble');return;}
    showStep('3');
  } else if(from==='3') {
    if(!v('nombre-propietario')||!v('tel-propietario')||!v('email-propietario')||!v('nombre-residente')||!v('tel-residente')||!v('tipo-doc')||!v('num-doc')){showError('err-propietario');return;}
    showStep('4');
  } else if(from==='4') {
    habitaPropietario=v('habita');
    if(!habitaPropietario){showError('err-habita');return;}
    showStep(habitaPropietario==='Sí'?'5a':'5b');
  } else if(from==='5a') {
    if(!v('menores-5a')||!v('adultos-5a')||!v('adultos-m-5a')){showError('err-5a');return;}
    showStep('6');
  } else if(from==='5b') {
    if(!v('menores-5b')||!v('adultos-5b')||!v('adultos-m-5b')){showError('err-5b');return;}
    showStep('6');
  } else if(from==='6') {
    if(!v('tiene-mascotas')){showError('err-mascotas');return;}
    showStep('7');
  } else if(from==='7') {
    if(!v('tiene-c1')){showError('err-carros');return;}
    showStep('8');
  } else if(from==='8') {
    if(!v('tiene-mo1')){showError('err-motos');return;}
    showStep('9');
  } else if(from==='9') {
    if(!v('tiene-bici')){showError('err-bici');return;}
    buildResumen();
    showStep('10');
  }
}

function prevStep(from) {
  if(from==='2') showStep('1');
  else if(from==='3') showStep('2');
  else if(from==='4') showStep('3');
  else if(from==='5a'||from==='5b') showStep('4');
  else if(from==='6') showStep(habitaPropietario==='Sí'?'5a':'5b');
  else if(from==='7') showStep('6');
  else if(from==='8') showStep('7');
  else if(from==='9') showStep('8');
  else if(from==='10') showStep('9');
}

function v(id) { const el=document.getElementById(id); return el?el.value.trim():''; }
function showError(id) { const el=document.getElementById(id); if(el){el.classList.add('show');setTimeout(()=>el.classList.remove('show'),5000);} }
function hideAllErrors() { document.querySelectorAll('.error-msg').forEach(e=>e.classList.remove('show')); }
function showConditional(id) { const el=document.getElementById(id); if(el) el.classList.add('show'); }
function hideConditional(id) { const el=document.getElementById(id); if(el) el.classList.remove('show'); }

function selectRadio(fieldId, value, btn) {
  document.getElementById(fieldId).value=value;
  btn.closest('.radio-group').querySelectorAll('.radio-btn').forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
}

function toggleMascotas() {
  const cant=parseInt(v('cant-mascotas'))||0;
  document.getElementById('bloque-mascota-1').style.display=cant>=1?'block':'none';
  document.getElementById('bloque-mascota-2').style.display=cant>=2?'block':'none';
  document.getElementById('bloque-mascota-3').style.display=cant>=3?'block':'none';
}

// ── Resumen ──────────────────────────────────────────────────────────────
function personasResumenHTML(label, arr) {
  if (!arr || arr.length === 0) return '';
  return arr.map((p,i) => {
    if (!p.nombre && !p.numDoc) return '';
    return `<strong>${label} ${i+1}:</strong> ${p.nombre||'—'} · ${p.tipoDoc||'—'} ${p.numDoc||'—'}${p.fechaNacimiento ? ' · Nac: '+p.fechaNacimiento:''}<br>`;
  }).join('');
}

function buildResumen() {
  const sfx=habitaPropietario==='Sí'?'-5a':'-5b';
  const tipoSfx=habitaPropietario==='Sí'?'5a':'5b';

  const menores = recolectarPersonas('menores', tipoSfx);
  const adultos = recolectarPersonas('adultos', tipoSfx);
  const adultosMayores = recolectarPersonas('adultos-m', tipoSfx);

  document.getElementById('resumen-contenido').innerHTML=`
    <strong>🏢 Torre:</strong> ${v('torre')} — Apto ${v('apto')}<br>
    <strong>🗄️ Depósito:</strong> ${v('tiene-deposito')} ${v('num-deposito') ? '— '+v('num-deposito') : ''}<br>
    <strong>👤 Propietario:</strong> ${v('nombre-propietario')}<br>
    <strong>📱 Tel. Propietario:</strong> ${v('tel-propietario')}<br>
    ${v('email-propietario') ? `<strong>📧 Email Propietario:</strong> ${v('email-propietario')}<br>` : ''}
    <strong>👤 Residente:</strong> ${v('nombre-residente')}<br>
    <strong>📱 Teléfono:</strong> ${v('tel-residente')}<br>
    <strong>🏠 Propietario habita:</strong> ${v('habita')}<br>
    <br>
    ${adultos.length ? personasResumenHTML('🧑 Adulto', adultos) : ''}
    ${menores.length ? personasResumenHTML('👶 Menor', menores) : ''}
    ${adultosMayores.length ? personasResumenHTML('👴 Adulto Mayor', adultosMayores) : ''}
    <strong>🐾 Mascotas:</strong> ${v('tiene-mascotas')} ${v('cant-mascotas')?'('+v('cant-mascotas')+')':''}<br>
    <strong>🚗 Carro 1:</strong> ${v('tiene-c1')} ${v('c1-placa')?'— '+v('c1-placa'):''}<br>
    <strong>🚗 Carro 2:</strong> ${v('tiene-c2')||'No'} ${v('c2-placa')?'— '+v('c2-placa'):''}<br>
    <strong>🏍️ Moto 1:</strong> ${v('tiene-mo1')} ${v('mo1-placa')?'— '+v('mo1-placa'):''}<br>
    <strong>🏍️ Moto 2:</strong> ${v('tiene-mo2')||'No'} ${v('mo2-placa')?'— '+v('mo2-placa'):''}<br>
    <strong>🚲 Bicicleta:</strong> ${v('tiene-bici')} ${v('bici-cantidad')?'('+v('bici-cantidad')+')':''}<br>
  `;
}

// ── Envío ────────────────────────────────────────────────────────────────
async function submitForm() {
  const loading=document.getElementById('loading');
  loading.classList.add('show');
  const sfx=habitaPropietario==='Sí'?'-5a':'-5b';
  const tipoSfx=habitaPropietario==='Sí'?'5a':'5b';

  const data = {
    torre:v('torre'), apto:v('apto'),
    tieneDeposito:v('tiene-deposito'), numDeposito:v('num-deposito'),
    nombrePropietario:v('nombre-propietario'), telPropietario:v('tel-propietario'),
    emailPropietario:v('email-propietario'),
    nombreResidente:v('nombre-residente'), telResidente:v('tel-residente'),
    emailResidente:v('email-residente'), tipoDoc:v('tipo-doc'), numDoc:v('num-doc'),
    habitaPropietario:v('habita'),
    // Adultos
    tieneAdultos:v('adultos'+sfx),
    adultos: recolectarPersonas('adultos', tipoSfx),
    // Menores
    tieneMenores:v('menores'+sfx),
    menores: recolectarPersonas('menores', tipoSfx),
    // Adultos mayores
    tieneAdultosMayores:v('adultos-m'+sfx),
    adultosMayores: recolectarPersonas('adultos-m', tipoSfx),
    // Mascotas
    tieneMascotas:v('tiene-mascotas'), cantMascotas:v('cant-mascotas'),
    m1Tipo:v('m1-tipo'), m1Nombre:v('m1-nombre'), m1Raza:v('m1-raza'), m1Tamano:v('m1-tamano'),
    m2Tipo:v('m2-tipo'), m2Nombre:v('m2-nombre'), m2Raza:v('m2-raza'), m2Tamano:v('m2-tamano'),
    m3Tipo:v('m3-tipo'), m3Nombre:v('m3-nombre'), m3Raza:v('m3-raza'), m3Tamano:v('m3-tamano'),
    // Carros
    tieneCarro1:v('tiene-c1'), c1Placa:v('c1-placa'), c1Marca:v('c1-marca'), c1Modelo:v('c1-modelo'), c1Color:v('c1-color'), c1Parq:v('c1-parq'), c1NumParq:v('c1-num-parq'),
    tieneCarro2:v('tiene-c2'), c2Placa:v('c2-placa'), c2Marca:v('c2-marca'), c2Modelo:v('c2-modelo'), c2Color:v('c2-color'), c2Parq:v('c2-parq'), c2NumParq:v('c2-num-parq'),
    // Motos
    tieneMoto1:v('tiene-mo1'), mo1Tipo:v('mo1-tipo'), mo1Placa:v('mo1-placa'), mo1Marca:v('mo1-marca'), mo1Modelo:v('mo1-modelo'), mo1Color:v('mo1-color'), mo1Parq:v('mo1-parq'), mo1NumParq:v('mo1-num-parq'),
    tieneMoto2:v('tiene-mo2'), mo2Tipo:v('mo2-tipo'), mo2Placa:v('mo2-placa'), mo2Marca:v('mo2-marca'), mo2Modelo:v('mo2-modelo'), mo2Color:v('mo2-color'), mo2Parq:v('mo2-parq'), mo2NumParq:v('mo2-num-parq'),
    // Bicicletas
    tieneBici:v('tiene-bici'), biciCantidad:v('bici-cantidad'), biciMarca:v('bici-marca'), biciColor:v('bici-color'), biciParq:v('bici-parq'), biciNumParq:v('bici-num-parq'),
    // Consentimientos
    aceptaHabeasData: true,
    aceptaTerminos: true
  };
  try {
    await window.saveToFirestore(data);
    loading.classList.remove('show');
    showStep('success');
  } catch(e) {
    loading.classList.remove('show');
    showError('err-envio');
  }
}

updateProgress('1');
</script>
</body>
</html>