<title>Credenciales del Sistema — PCO3</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
<style>
:root{
  --accent:#1e3a5f;--accent2:#2563eb;--accent-light:#dbeafe;
  --gbtn:linear-gradient(135deg,#1e3a5f,#2563eb);
  --bg:#eef2f7;--white:#fff;--text:#0f172a;--text2:#475569;
  --border:#cbd5e1;--green:#16a34a;--green-light:#f0fdf4;
  --red:#dc2626;--yellow:#f59e0b;--yellow-light:#fffbeb;
  --font:'DM Sans',sans-serif;--fd:'DM Serif Display',serif;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);font-family:var(--font);color:var(--text);padding:24px 16px 48px;}

/* ── HEADER ── */
.header{
  background:var(--gbtn);border-radius:16px;padding:28px 24px 24px;
  margin-bottom:24px;display:flex;align-items:center;gap:16px;
}
.header-logo{
  width:56px;height:56px;background:rgba(255,255,255,.15);
  border-radius:14px;display:flex;align-items:center;justify-content:center;
  font-size:28px;flex-shrink:0;
}
.header-title{font-family:var(--fd);font-size:22px;color:#fff;margin-bottom:3px;}
.header-sub{font-size:12px;color:rgba(255,255,255,.65);}
.header-actions{margin-left:auto;display:flex;gap:8px;flex-shrink:0;}
.btn-print{
  padding:9px 16px;background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.3);border-radius:8px;
  color:#fff;font-family:var(--font);font-size:12px;font-weight:700;
  cursor:pointer;transition:all .2s;
}
.btn-print:hover{background:rgba(255,255,255,.25);}

/* ── ALERTA ── */
.alerta{
  background:var(--yellow-light);border:1.5px solid var(--yellow);
  border-radius:12px;padding:14px 16px;margin-bottom:20px;
  font-size:13px;color:#92400e;line-height:1.6;
}
.alerta strong{font-weight:700;}

/* ── SECCIÓN ── */
.section-label{
  font-size:10px;font-weight:700;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--text2);margin:24px 0 10px;
}

/* ── GRID CREDENCIALES ── */
.cred-grid{display:grid;gap:10px;grid-template-columns:1fr;}
@media(min-width:600px){.cred-grid{grid-template-columns:1fr 1fr;}}
@media(min-width:900px){.cred-grid{grid-template-columns:1fr 1fr 1fr;}}

.cred-card{
  background:var(--white);border:1px solid var(--border);
  border-radius:12px;padding:16px;
  display:flex;flex-direction:column;gap:10px;
}
.cred-top{display:flex;align-items:center;gap:10px;}
.cred-icono{
  width:40px;height:40px;border-radius:10px;
  display:flex;align-items:center;justify-content:center;font-size:20px;
  flex-shrink:0;
}
.cred-rol{font-size:14px;font-weight:700;color:var(--accent);}
.cred-modulo{font-size:11px;color:var(--text2);margin-top:1px;}
.cred-fields{display:flex;flex-direction:column;gap:6px;}
.cred-field{
  background:var(--bg);border-radius:8px;padding:8px 12px;
  display:flex;justify-content:space-between;align-items:center;gap:8px;
}
.cred-field-label{font-size:11px;color:var(--text2);font-weight:500;flex-shrink:0;}
.cred-field-val{
  font-size:13px;font-weight:700;color:var(--text);
  font-family:monospace;letter-spacing:.3px;
}
.copy-btn{
  background:none;border:none;cursor:pointer;font-size:14px;
  padding:2px;opacity:.5;transition:opacity .15s;flex-shrink:0;
}
.copy-btn:hover{opacity:1;}
.cred-url{
  font-size:11px;color:var(--accent2);word-break:break-all;
  line-height:1.5;border-top:1px solid var(--border);padding-top:8px;
}

/* ── TABLA RESUMEN ── */
.tabla-wrap{overflow-x:auto;margin-top:8px;}
table{width:100%;border-collapse:collapse;font-size:13px;}
th{
  background:var(--accent);color:#fff;padding:10px 14px;
  text-align:left;font-weight:600;font-size:11px;letter-spacing:.5px;
}
th:first-child{border-radius:8px 0 0 0;}
th:last-child{border-radius:0 8px 0 0;}
td{padding:10px 14px;border-bottom:1px solid var(--border);}
tr:last-child td{border-bottom:none;}
tr:nth-child(even) td{background:#f8fafc;}
td code{
  font-family:monospace;font-size:12px;background:var(--accent-light);
  color:var(--accent);padding:2px 7px;border-radius:5px;
}

/* ── NOTAS ── */
.notas-card{
  background:var(--white);border:1px solid var(--border);
  border-radius:12px;padding:18px 16px;margin-top:10px;
}
.notas-title{font-size:14px;font-weight:700;color:var(--accent);margin-bottom:12px;}
.nota-item{
  display:flex;gap:10px;padding:8px 0;
  border-bottom:1px solid var(--bg);font-size:13px;line-height:1.5;
}
.nota-item:last-child{border-bottom:none;}
.nota-num{
  width:22px;height:22px;background:var(--gbtn);color:#fff;
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:700;flex-shrink:0;margin-top:1px;
}

/* ── PRINT ── */
@media print{
  body{background:#fff;padding:16px;}
  .btn-print,.header-actions{display:none!important;}
  .cred-card{break-inside:avoid;}
  .alerta{border:1px solid #000;}
}
</style>
</head>
